<UserControl x:Class="KnolTeacher.Desktop.Views.Controls.BoardWidgetHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="240" MinHeight="180">
    <UserControl.Resources>
        <!--
            Large transparent hit targets are intentional for classroom touch displays.
            The visible marker is small, but each Thumb is at least 32 DIP thick.
        -->
        <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Ellipse x:Name="Marker"
                                     Width="6" Height="6"
                                     Fill="#64748B"
                                     Stroke="#38BDF8"
                                     StrokeThickness="0.8"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter TargetName="Marker" Property="Width" Value="9"/>
                                <Setter TargetName="Marker" Property="Height" Value="9"/>
                                <Setter TargetName="Marker" Property="Fill" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="False">
        <!-- Main Outer Widget Card -->
        <Border x:Name="OuterBorder"
                Background="#F21E293B"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.55" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Touch-friendly title / drag handle -->
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" x:Name="TitleBar"
                        Background="#111827"
                        CornerRadius="10,10,0,0"
                        BorderBrush="#334155"
                        BorderThickness="0,0,0,1"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                    <Grid Margin="12,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock x:Name="TxtLockIcon" Text="🔒" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtDragGrip" Text="⋮⋮" Foreground="#64748B" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   x:Name="TxtTitle"
                                   Text="위젯 제목"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ZoomControlsContainer"
                                    Background="#1E293B"
                                    CornerRadius="6"
                                    Padding="2,0"
                                    Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnZoomOut_Click"
                                            Width="30" Height="30" Padding="0"
                                            Background="Transparent" Foreground="#CBD5E1"
                                            BorderThickness="0" Cursor="Hand"
                                            ToolTip="내부 글씨·숫자 축소 (-)">
                                        <TextBlock Text="−" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock x:Name="TxtZoomLevel"
                                               Text="100%"
                                               FontSize="10"
                                               Foreground="#38BDF8"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="3,0"/>
                                    <Button Click="BtnZoomIn_Click"
                                            Width="30" Height="30" Padding="0"
                                            Background="Transparent" Foreground="#CBD5E1"
                                            BorderThickness="0" Cursor="Hand"
                                            ToolTip="내부 글씨·숫자 확대 (+)">
                                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Separator Margin="3,6" Width="1" Background="#334155"/>

                            <Button Click="BtnClose_Click"
                                    Width="34" Height="34"
                                    Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="위젯 닫기">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bClose" CornerRadius="17" Background="Transparent">
                                            <TextBlock Text="✕"
                                                       Foreground="#CBD5E1"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bClose" Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bClose" Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <ContentPresenter Grid.Row="1" x:Name="HostContentPresenter" Margin="9,9,9,9">
                    <ContentPresenter.LayoutTransform>
                        <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    </ContentPresenter.LayoutTransform>
                </ContentPresenter>
            </Grid>
        </Border>

        <!--
            8-direction resize layer. It has no Background so only the Thumb hit targets
            intercept pointer/touch input; the widget body remains interactive.
        -->
        <Grid x:Name="ResizeLayer" Panel.ZIndex="50">
            <Thumb Tag="N" Width="72" Height="32"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Cursor="SizeNS" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="S" Width="72" Height="32"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="W" Width="32" Height="72"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Cursor="SizeWE" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="E" Width="32" Height="72"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Cursor="SizeWE" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Tag="NW" Width="36" Height="36"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="NE" Width="36" Height="36"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="SW" Width="36" Height="36"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="SE" Width="36" Height="36"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
        </Grid>
    </Grid>
</UserControl>
