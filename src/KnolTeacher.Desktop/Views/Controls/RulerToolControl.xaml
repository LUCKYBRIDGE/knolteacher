<UserControl x:Class="KnolTeacher.Desktop.Views.Controls.RulerToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460" Height="80"
             Cursor="SizeAll"
             MouseLeftButtonDown="Ruler_MouseLeftButtonDown"
             MouseMove="Ruler_MouseMove"
             MouseLeftButtonUp="Ruler_MouseLeftButtonUp">
    <UserControl.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="RulerRotate" Angle="0" CenterX="230" CenterY="40"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Border Background="#E6F8FAFC" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.4" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <!-- Ticks Canvas -->
            <Canvas x:Name="CanvasTicks" Margin="10,0,10,0" Height="30" VerticalAlignment="Top"/>

            <!-- Center Info & Rotate Handle -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <TextBlock Text="📏 직선자 (0~20cm)" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtAngle" Text="0°" FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
                <Button Content="↺ -15°" Click="BtnRotateCCW_Click" Height="22" Padding="6,0" Margin="0,0,3,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                <Button Content="↻ +15°" Click="BtnRotateCW_Click" Height="22" Padding="6,0" Margin="0,0,12,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                <Button Content="0° 리셋" Click="BtnResetAngle_Click" Height="22" Padding="6,0" Margin="0,0,8,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                <Button Content="✕" Click="BtnClose_Click" Width="22" Height="22" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="11"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>