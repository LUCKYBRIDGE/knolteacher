<Window x:Class="KnolTeacher.Desktop.Views.Windows.QrCodeModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📱 QR 코드 스캔 및 공유" 
        Height="540" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BeigeWindowBg}">

    <Border Padding="24" Background="{DynamicResource BeigeWindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="📱 바로가기 QR 코드" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="학생용 태블릿이나 스마트폰 카메라로 비추면 즉시 열립니다." FontSize="11" Foreground="{DynamicResource BeigeTextSub}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- QR Code Card -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="2" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1" Color="#000000"/>
                </Border.Effect>
                <Image x:Name="ImgQrCode" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- URL & Input -->
            <StackPanel Grid.Row="2" Margin="0,14,0,14">
                <TextBlock Text="연결 주소 (URL / 텍스트)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TbUrl" Grid.Column="0" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" FontSize="12" TextChanged="TbUrl_TextChanged"/>
                    <Button Grid.Column="1" Content="주소 복사" Click="BtnCopyUrl_Click" Height="34" Padding="12,0" Margin="6,0,0,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="📋 이미지 복사" Click="BtnCopyImage_Click" Height="38" Margin="0,0,6,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="💾 PNG 파일 저장" Click="BtnSaveImage_Click" Height="38" Margin="0,0,6,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="2" Content="닫기" Click="BtnClose_Click" Height="38" Padding="16,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
