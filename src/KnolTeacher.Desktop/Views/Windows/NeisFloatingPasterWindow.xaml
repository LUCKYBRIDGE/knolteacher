<Window x:Class="KnolTeacher.Desktop.Views.Windows.NeisFloatingPasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나이스 평어 순차 입력기" 
        Height="280" Width="400"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1E293B">

    <Border BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="12" Background="#0F172A" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="📝 나이스 평어 순차 입력기" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="(항상 위)" FontSize="10" Foreground="#64748B" Margin="6,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="24" Height="24" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- Student Info Banner -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStudentBadge" Grid.Column="0" Text="👤 [1번 김도윤] (1 / 23명)" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtByteBadge" Grid.Column="1" Text="479 Byte" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Comment Content Box -->
            <TextBox x:Name="TbCommentPreview" Grid.Row="2" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#020617" Foreground="#E2E8F0" BorderBrush="#334155" Padding="8" FontSize="12" Margin="0,0,0,10"/>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="◀ 이전" Click="BtnPrev_Click" Height="36" Padding="12,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="📋 복사 후 다음으로 (Space)" Click="BtnCopyAndNext_Click" Height="36" Margin="6,0" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="다음 ▶" Click="BtnNext_Click" Height="36" Padding="12,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
