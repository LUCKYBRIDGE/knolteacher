<Window x:Class="KnolTeacher.Desktop.Views.Windows.NeisFloatingPasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나이스 평어 순차 입력기" 
        Height="360" Width="450"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1E293B">

    <Border BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="12" Background="#0F172A" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Tip Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Student Info -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Preview -->
                <RowDefinition Height="*"/>
                <!-- 4: Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="📝 나이스 평어 순차 입력 도우미" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="(항상 위)" FontSize="10" Foreground="#64748B" Margin="6,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="❓ 사용법" Click="BtnHelp_Click" Height="22" Padding="6,0" Margin="0,0,6,0" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#3B82F6" BorderThickness="1" FontSize="10" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="2" Content="✕" Click="BtnClose_Click" Width="24" Height="24" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- 1. Hotkey Notice Banner -->
            <Border Grid.Row="1" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="나이스 평어 칸 클릭 후 키보드 [F8] 키만 누르면 자동 붙여넣기 + 다음 학생으로 이동합니다!" FontSize="11" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 2. Student Info Banner -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStudentBadge" Grid.Column="0" Text="👤 [1번 김도윤] (1 / 23명)" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtByteBadge" Grid.Column="1" Text="479 Byte" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Comment Content Box -->
            <TextBox x:Name="TbCommentPreview" Grid.Row="3" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#020617" Foreground="#E2E8F0" BorderBrush="#334155" Padding="8" FontSize="12" Margin="0,0,0,8"/>

            <!-- 4. Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Line 1: Primary Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀ 이전" Click="BtnPrev_Click" Height="36" Padding="10,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnAutoPaste" Grid.Column="1" Content="⚡ 자동입력 (F8 / Space)" Click="BtnCopyAndNext_Click" Height="36" Margin="6,0" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="현재 학생 평어를 클립보드에 복사하고 나이스 창에 자동 붙여넣습니다.">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="다음 ▶" Click="BtnNext_Click" Height="36" Padding="10,0" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <!-- Line 2: Auto Continuous Macro -->
                <Grid Grid.Row="1">
                    <Button x:Name="BtnAutoSequence" Content="▶ 1.5초 간격 전원 자동 순차 입력 시작" Click="BtnAutoSequence_Click" Height="30" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="3초 대기 후 1.5초 간격으로 나이스에 자동 입력합니다 (Esc로 즉시 중단)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>