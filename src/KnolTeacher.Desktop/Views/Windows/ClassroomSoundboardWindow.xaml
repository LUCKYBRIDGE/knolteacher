<Window x:Class="KnolTeacher.Desktop.Views.Windows.ClassroomSoundboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="교실 효과음 사운드보드"
        Height="510" Width="630"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="/assets/app_icon.ico"
        Background="{DynamicResource BeigeAppBg}">

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Sound Grid -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="원터치 교실 효과음 사운드보드" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="퀴즈, 발표, 모둠 활동 및 교실 집중 지도시 원클릭 또는 숫자키(1~8)로 즉시 효과음을 재생합니다." FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 8 Sound Effect Buttons Grid -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="2" Margin="0,0,0,10">
            <!-- 1. Ding Dong Dang -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#86EFAC" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnDingDong_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="딩동댕 (정답)" FontWeight="Bold" FontSize="13" Foreground="#166534" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [1]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. Buzzer / Ddaeng -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#FCA5A5" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnBuzzer_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="❌" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="땡! (오답)" FontWeight="Bold" FontSize="13" Foreground="#991B1B" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [2]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Applause -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#FDE68A" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnApplause_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👏" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="박수 갈채" FontWeight="Bold" FontSize="13" Foreground="#92400E" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [3]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. Fanfare -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#C7D2FE" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnFanfare_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎺" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="축하 팡파레" FontWeight="Bold" FontSize="13" Foreground="#3730A3" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [4]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 5. Drumroll -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#E9D5FF" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnDrumroll_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🥁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="두근두근 드럼" FontWeight="Bold" FontSize="13" Foreground="#6B21A8" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [5]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 6. Attention Chime -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#BAE6FD" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnChime_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏰" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="집중 차임벨" FontWeight="Bold" FontSize="13" Foreground="#0369A1" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [6]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 7. Whistle -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#FED7AA" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnWhistle_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🚨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="심판 호각" FontWeight="Bold" FontSize="13" Foreground="#C2410C" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [7]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 8. Countdown Tick -->
            <Border Margin="5" Background="{DynamicResource BeigeCardBg}" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="12" Padding="10" Cursor="Hand" MouseLeftButtonUp="BtnTick_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏱️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="카운트다운 틱" FontWeight="Bold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>
                    <TextBlock Text="단축키 [8]" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Footer Help -->
        <Border Grid.Row="2" Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <Grid>
                <TextBlock Text="💡 창이 열려있는 상태에서 키보드 숫자 1 ~ 8을 누르면 마우스 클릭 없이 즉시 재생됩니다." FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" VerticalAlignment="Center"/>
                <TextBlock Text="항상 위 고정 ON" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
