<Window x:Class="KnolTeacher.Desktop.Views.Windows.ClassroomCountdownOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔔 수업 시작 전 카운트다운"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F5090D16"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="30" Color="#38BDF8" Opacity="0.6"/>
    </Window.Resources>

    <Grid Margin="40">
        <Border Background="#F21E293B" CornerRadius="24" BorderBrush="#38BDF8" BorderThickness="2" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.8" ShadowDepth="10"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Period Badge & Notice -->
                    <RowDefinition Height="Auto" />
                    <!-- Massive Countdown Digits -->
                    <RowDefinition Height="*" />
                    <!-- Post-completion banner & Controls -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#0284C7" CornerRadius="12" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtPeriodBadge" Text="🕒 2교시 수업 준비" FontWeight="Bold" FontSize="18" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="TxtNotice" Text="🔔 수업 준비 시간입니다! 자리에 앉아 교과서를 준비해 주세요." FontWeight="Bold" FontSize="26" Foreground="#FDE047" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>

                <!-- Center: Giant Countdown Digits (Viewbox) -->
                <Grid Grid.Row="1" Margin="20,10">
                    <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtCountdown" Text="02:00" FontFamily="Consolas, Malgun Gothic" FontWeight="Bold" Foreground="#38BDF8" Effect="{StaticResource GlowEffect}"/>
                    </Viewbox>
                </Grid>

                <!-- Bottom Status & Actions -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <!-- Completion Banner -->
                    <Border x:Name="BorderComplete" Background="#064E3B" CornerRadius="12" BorderBrush="#10B981" BorderThickness="1.5" Padding="16,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="TxtPostNotice" Text="👏 수업 준비 완료! 자리에 모두 착석했습니다." FontWeight="Bold" FontSize="22" Foreground="#34D399" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="PbProgress" Height="8" Minimum="0" Maximum="100" Value="100" Foreground="#38BDF8" Background="#0F172A" BorderThickness="0" Margin="0,0,0,16"/>

                    <!-- Action Bar -->
                    <Grid>
                        <TextBlock x:Name="TxtAutoCloseNotice" Text="카운트다운 진행 중..." FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Content="✕ 화면 닫기 (Esc)" Click="BtnClose_Click" HorizontalAlignment="Right" Padding="20,8" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
