<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🌱 뽑기 레이스 (Alt+8)" Height="780" Width="1240"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#1E1E24">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Title & Options Bar -->
            <RowDefinition Height="52" />
            <!-- 2. Main 3-Column Playfield (Minimap | Race Track | Leaderboard) -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Control Bar -->
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. TOP HEADER & TOPIC BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌱" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="뽑기 레이스" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Configurable Race Topic Banner -->
                <StackPanel x:Name="PanelTitle" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="TbRaceTitle" Text="이번엔 1등, 꼴등이 받아요"
                             FontSize="20" FontWeight="Bold" Foreground="White"
                             Background="Transparent" BorderThickness="0"
                             TextAlignment="Center" VerticalAlignment="Center"
                             Cursor="IBeam" ToolTip="클릭하여 이번 뽑기 레이스 제목을 직접 수정할 수 있습니다"/>
                    <Button x:Name="BtnHideTitle" Content="제목 숨기기" Click="BtnHideTitle_Click"
                            Margin="12,0,0,0" Padding="8,4" FontSize="11"
                            Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Options & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Target Winner Count Picker -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⭐ 순위" FontSize="12" FontWeight="Bold" Foreground="#E4E4E7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CbWinnerCount" Width="74" Height="28" FontSize="12" FontWeight="Bold"
                                  Background="#27272A" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="1명" IsSelected="True"/>
                            <ComboBoxItem Content="2명"/>
                            <ComboBoxItem Content="3명"/>
                            <ComboBoxItem Content="4명"/>
                            <ComboBoxItem Content="5명"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- View Results Button -->
                    <Button x:Name="BtnViewResult" Content="결과 보기" Click="BtnViewResult_Click"
                            Padding="12,6" Margin="0,0,10,0" Height="30"
                            Background="#EA580C" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Monitor Switcher -->
                    <Button x:Name="BtnSwitchMonitor" Content="📺 모니터 2" Click="BtnSwitchMonitor_Click"
                            Padding="10,6" Margin="0,0,8,0" Height="30"
                            Background="#27272A" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Exclude Picked Checkbox -->
                    <CheckBox x:Name="ChkExcludePicked" Content="뽑힌 학생 제외" IsChecked="True" Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. MAIN 3-PANEL PLAYFIELD -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Minimap (180px) -->
                <ColumnDefinition Width="180" />
                <!-- Center: Main Race Camera Viewport (*) -->
                <ColumnDefinition Width="*" />
                <!-- Right: Leaderboard (210px) -->
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <!-- 2-A. LEFT PANEL: 전체맵 (MINIMAP) -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🗺️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="전체맵" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minimap Box -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" BorderBrush="#334155" BorderThickness="1.5" ClipToBounds="True">
                        <Canvas x:Name="MinimapCanvas" Width="154" Height="620" ClipToBounds="True">
                            <!-- Background unified cartoon preview of the whole track -->
                            <Rectangle x:Name="MinimapBg" Width="154" Height="620">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#84CC16" Offset="0"/>
                                        <GradientStop Color="#65A30D" Offset="0.18"/>
                                        <GradientStop Color="#4D7C0F" Offset="0.38"/>
                                        <GradientStop Color="#15803D" Offset="0.60"/>
                                        <GradientStop Color="#166534" Offset="0.78"/>
                                        <GradientStop Color="#0F766E" Offset="0.90"/>
                                        <GradientStop Color="#0284C7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Live dots representing students on minimap -->
                            <Canvas x:Name="MinimapDotsLayer" Width="154" Height="620"/>

                            <!-- Current Camera Viewport Finder Box -->
                            <Border x:Name="MinimapViewportBox" Canvas.Left="0" Canvas.Top="0" Width="154" Height="150"
                                    BorderBrush="#FDE047" BorderThickness="2" Background="#20FDE047" IsHitTestVisible="False" CornerRadius="4"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- 2-B. CENTER PANEL: MAIN RACE CAMERA VIEWPORT -->
            <Grid Grid.Column="1" x:Name="RaceViewport" ClipToBounds="True" Background="#0D1520" SizeChanged="RaceViewport_SizeChanged">
                <ScrollViewer x:Name="RaceScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Top"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="RaceScrollViewer_PreviewMouseWheel">

                    <Grid x:Name="RaceWorld" Width="680" Height="2200" HorizontalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="RaceWorldScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <!-- Main Playfield Canvas -->
                        <Canvas x:Name="RaceCanvas" Width="680" Height="2200" ClipToBounds="True">

                            <!-- ================================================= -->
                            <!-- UNIFIED CARTOON ADVENTURE FOREST COURSE BACKGROUND -->
                            <!-- ================================================= -->
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="680" Height="2200">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#84CC16" Offset="0"/>     <!-- 1. Sunny Canopy -->
                                        <GradientStop Color="#65A30D" Offset="0.18"/>  <!-- 2. Grassy Hill Slope -->
                                        <GradientStop Color="#4D7C0F" Offset="0.38"/>  <!-- 3. Forest Woodland -->
                                        <GradientStop Color="#15803D" Offset="0.60"/>  <!-- 4. Enchanted Glade -->
                                        <GradientStop Color="#166534" Offset="0.78"/>  <!-- 5. Mushroom Hollow -->
                                        <GradientStop Color="#0F766E" Offset="0.90"/>  <!-- 6. Riverbank -->
                                        <GradientStop Color="#0284C7" Offset="1.0"/>   <!-- 7. Crystal Water Slide -->
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Winding Stylized Cartoon Adventure Trail -->
                            <Path Data="M 340,160 C 340,360 180,520 270,760 C 360,1000 520,1180 430,1440 C 340,1700 340,1920 340,2050"
                                  Stroke="#FDE68A" StrokeThickness="220" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.3"/>
                            <Path Data="M 340,160 C 340,360 180,520 270,760 C 360,1000 520,1180 430,1440 C 340,1700 340,1920 340,2050"
                                  Stroke="#FDE047" StrokeThickness="130" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45"/>

                            <!-- Left & Right Cartoon Bushes Lining Boundaries -->
                            <Image Canvas.Left="10" Canvas.Top="260" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="580" Canvas.Top="260" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="15" Canvas.Top="580" Width="80" Height="52" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="585" Canvas.Top="580" Width="80" Height="52" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="10" Canvas.Top="920" Width="85" Height="55" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="585" Canvas.Top="920" Width="85" Height="55" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="20" Canvas.Top="1240" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="575" Canvas.Top="1240" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="15" Canvas.Top="1560" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>
                            <Image Canvas.Left="580" Canvas.Top="1560" Width="90" Height="58" Source="pack://application:,,,/assets/race/cartoon_bush.png"/>

                            <!-- Decorative Cartoon Pebbles -->
                            <Image Canvas.Left="55" Canvas.Top="420" Width="45" Height="34" Source="pack://application:,,,/assets/race/cartoon_pebble.png"/>
                            <Image Canvas.Left="580" Canvas.Top="420" Width="45" Height="34" Source="pack://application:,,,/assets/race/cartoon_pebble.png"/>
                            <Image Canvas.Left="60" Canvas.Top="1080" Width="50" Height="38" Source="pack://application:,,,/assets/race/cartoon_pebble.png"/>
                            <Image Canvas.Left="570" Canvas.Top="1080" Width="50" Height="38" Source="pack://application:,,,/assets/race/cartoon_pebble.png"/>

                            <!-- ================================================= -->
                            <!-- ZONE 1: 🌴 출발선 (Y = 0 ~ 240) -->
                            <!-- ================================================= -->
                            <!-- Festive Party Bunting Arch -->
                            <Image Canvas.Left="40" Canvas.Top="80" Width="600" Height="110"
                                   Source="pack://application:,,,/assets/race/cartoon_start_banner.png"/>

                            <!-- Wooden Start Gate Platform Line -->
                            <Border Canvas.Left="40" Canvas.Top="170" Width="600" Height="16" CornerRadius="8" Background="#78350F" BorderBrush="#CA8A04" BorderThickness="2"/>

                            <!-- ================================================= -->
                            <!-- ZONE 2: 🪵 슬로프 & 카툰 목재 가이드 레일 (Y = 240 ~ 720) -->
                            <!-- ================================================= -->
                            <!-- Slanted Wooden Rails -->
                            <Image Canvas.Left="70" Canvas.Top="320" Width="220" Height="60"
                                   Source="pack://application:,,,/assets/race/cartoon_wood_rail.png" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><RotateTransform Angle="28"/></Image.RenderTransform>
                            </Image>
                            <Image Canvas.Left="390" Canvas.Top="320" Width="220" Height="60"
                                   Source="pack://application:,,,/assets/race/cartoon_wood_rail.png" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><RotateTransform Angle="-28"/></Image.RenderTransform>
                            </Image>

                            <!-- ================================================= -->
                            <!-- ZONE 3: 🌲 숲속 갈림길 가이드 레일 (Y = 720 ~ 1300) -->
                            <!-- ================================================= -->
                            <Image Canvas.Left="40" Canvas.Top="1120" Width="220" Height="60"
                                   Source="pack://application:,,,/assets/race/cartoon_wood_rail.png" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><RotateTransform Angle="22"/></Image.RenderTransform>
                            </Image>
                            <Image Canvas.Left="420" Canvas.Top="1120" Width="220" Height="60"
                                   Source="pack://application:,,,/assets/race/cartoon_wood_rail.png" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><RotateTransform Angle="-22"/></Image.RenderTransform>
                            </Image>

                            <!-- ================================================= -->
                            <!-- ZONE 4: 🍄 마법 버섯 숲 바운스존 (Y = 1300 ~ 1880) -->
                            <!-- (회전 통나무와 카툰 버섯 범퍼들은 C# 코드에서 동적 추가) -->
                            <!-- ================================================= -->

                            <!-- ================================================= -->
                            <!-- ZONE 5: 🌊 결승 워터 슬라이드 (Y = 1880 ~ 2200) -->
                            <!-- ================================================= -->
                            <!-- Funnel banks -->
                            <Path Data="M 0,1880 L 230,2030 L 230,2200 L 0,2200 Z" Fill="#1E293B"/>
                            <Path Data="M 680,1880 L 450,2030 L 450,2200 L 680,2200 Z" Fill="#1E293B"/>

                            <!-- Flowing Blue Waterfall Chute -->
                            <Rectangle Canvas.Left="230" Canvas.Top="1980" Width="220" Height="220">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                        <GradientStop Color="#0284C7" Offset="0.7"/>
                                        <GradientStop Color="#0369A1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Water Flow Ripples -->
                            <Path Data="M 240,2030 Q 340,2010 440,2030 M 240,2090 Q 340,2070 440,2090 M 240,2150 Q 340,2130 440,2150"
                                  Stroke="White" StrokeThickness="3" Opacity="0.7" StrokeDashArray="4,4"/>

                            <!-- Cartoon Water Splash -->
                            <Image Canvas.Left="260" Canvas.Top="2040" Width="160" Height="80"
                                   Source="pack://application:,,,/assets/race/cartoon_water_splash.png" Opacity="0.9"/>

                            <!-- Cartoon Finish Line Arch -->
                            <Image Canvas.Left="190" Canvas.Top="1980" Width="300" Height="75"
                                   Source="pack://application:,,,/assets/race/cartoon_finish_arch.png"/>

                            <!-- Finish trays for side settling -->
                            <Border Canvas.Left="35" Canvas.Top="2080" Width="160" Height="70" CornerRadius="14" Background="#1E293B" BorderBrush="#475569" BorderThickness="2">
                                <TextBlock Text="도전 완료 💫" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Canvas.Left="485" Canvas.Top="2080" Width="160" Height="70" CornerRadius="14" Background="#1E293B" BorderBrush="#475569" BorderThickness="2">
                                <TextBlock Text="도전 완료 💫" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- DYNAMIC PHYSICS PARTICLES & BALLS & BUMPERS ARE ADDED HERE -->
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- Winner Celebration Overlay -->
                <Grid x:Name="GridCelebration" Visibility="Collapsed" Background="#D9000000">
                    <Border Background="#18181B" CornerRadius="24" BorderBrush="#EA580C" BorderThickness="3"
                            Width="520" Height="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Color="#EA580C" Opacity="0.8"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎉 1등 골인! 당첨을 축하합니다! 🎉" FontWeight="Bold" FontSize="20" Foreground="#FDE047" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <!-- Big Winner Avatar (frameless) -->
                            <Border Width="130" Height="130" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Image x:Name="ImgWinnerAvatar" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <TextBlock x:Name="TxtWinnerTitle" Text="7번 김민준 (판다)" FontWeight="Bold" FontSize="28" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="오늘의 멋진 발표자입니다! 👏" FontSize="15" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="확인 / 계속하기" Click="BtnDismissCelebration_Click" Width="140" Height="44"
                                        Background="#3F3F46" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                                <Button Content="🚀 다음 뽑기 레이스" Click="BtnNextLaunch_Click" Width="160" Height="44"
                                        Background="#EA580C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2-C. RIGHT PANEL: 실시간 순위표 (LEADERBOARD) -->
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="순위" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scrollable Live Ranks List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanelLeaderboard"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. BOTTOM CONTROL BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Shortcuts Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 단축키: " FontSize="12" Foreground="#71717A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="Space (출발)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Esc (닫기)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                    </Border>
                </StackPanel>

                <!-- Center: 3 Big Control Buttons (i-Scream style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Re-select Button -->
                    <Button x:Name="BtnResetToStart" Content="← 다시 선택하기" Click="BtnResetToStart_Click"
                            Width="140" Height="44" Background="#27272A" Foreground="White"
                            FontWeight="Bold" FontSize="13" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand" Margin="0,0,12,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                    </Button>

                    <!-- Giant Orange Start Button -->
                    <Button x:Name="BtnStartRace" Click="BtnStartRace_Click"
                            Width="200" Height="48" Background="#EA580C" Foreground="White"
                            FontWeight="Bold" FontSize="19" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="24"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="18" Color="#EA580C" Opacity="0.6"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶ " FontSize="18"/>
                            <TextBlock x:Name="TxtBtnStartLabel" Text="시작하기"/>
                        </StackPanel>
                    </Button>

                    <!-- Reset Button -->
                    <Button x:Name="BtnInitAll" Content="↺ 초기화하기" Click="BtnInitAll_Click"
                            Width="120" Height="44" Background="#27272A" Foreground="White"
                            FontWeight="Bold" FontSize="13" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand" Margin="12,0,0,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Speed, Sound & Student Manage -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Speed Multiplier (1x / 2x / 3x) -->
                    <Button x:Name="BtnSpeedToggle" Content="> 1x" Click="BtnSpeedToggle_Click"
                            Width="56" Height="34" Margin="0,0,8,0"
                            Background="#27272A" Foreground="#FDE047" BorderBrush="#3F3F46" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="레이스 배속 (1x / 2x / 3x)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <!-- Sound Toggle -->
                    <Button x:Name="BtnSoundToggle" Content="🔊" Click="BtnSoundToggle_Click"
                            Width="44" Height="34" Margin="0,0,8,0"
                            Background="#27272A" Foreground="#38BDF8" BorderBrush="#3F3F46" BorderThickness="1" FontWeight="Bold" FontSize="14" Cursor="Hand" ToolTip="효과음 켜기/끄기">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <!-- Manage Roster -->
                    <Button Content="👥 학생 명단" Click="BtnManageRoster_Click"
                            Padding="10,0" Height="34"
                            Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="32종 동물 아바타 및 학생 명단 관리">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
