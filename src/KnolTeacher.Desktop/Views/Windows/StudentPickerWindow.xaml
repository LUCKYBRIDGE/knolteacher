<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🎲 발표자 추첨기 (Alt+8)" Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Winner Display -->
            <RowDefinition Height="*" />
            <!-- Options -->
            <RowDefinition Height="Auto" />
            <!-- Action Button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🎲 발표자 무작위 추첨" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Winner Card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="20" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="4" Color="#000000"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtWinnerNumber" Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Viewbox Stretch="Uniform" MaxHeight="90" Margin="16,0">
                    <TextBlock x:Name="TxtWinnerName" Text="추첨 준비 완료" FontSize="38" FontWeight="Bold" Foreground="#FDE047" HorizontalAlignment="Center"/>
                </Viewbox>
                <TextBlock x:Name="TxtRemaining" Text="남은 학생: 20명" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <CheckBox x:Name="ChkExcludePicked" Content="한 번 뽑힌 학생은 제외하기" IsChecked="True" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button Content="↺ 제외 목록 초기화" Click="BtnReset_Click" HorizontalAlignment="Right" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>

        <!-- Main Pick Button -->
        <Button x:Name="BtnPick" Grid.Row="3" Content="🎲 발표자 뽑기!" Click="BtnPick_Click" Padding="0,14" Background="#0284C7" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
        </Button>
    </Grid>
</Window>
