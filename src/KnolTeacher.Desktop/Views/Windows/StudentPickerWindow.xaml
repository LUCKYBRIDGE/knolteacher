<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🌱 뽑기 레이스 (Alt+8)" Height="780" Width="1240"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#1E1E24">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Title & Options Bar -->
            <RowDefinition Height="52" />
            <!-- 2. Main 3-Column Playfield (Minimap | Race Track | Leaderboard) -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Control Bar -->
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. TOP HEADER & TOPIC BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌱" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="뽑기 레이스" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Configurable Race Topic Banner -->
                <StackPanel x:Name="PanelTitle" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="TbRaceTitle" Text="이번엔 1등, 꼴등이 받아요"
                             FontSize="20" FontWeight="Bold" Foreground="White"
                             Background="Transparent" BorderThickness="0"
                             TextAlignment="Center" VerticalAlignment="Center"
                             Cursor="IBeam" ToolTip="클릭하여 이번 뽑기 레이스 제목을 직접 수정할 수 있습니다"/>
                    <Button x:Name="BtnHideTitle" Content="제목 숨기기" Click="BtnHideTitle_Click"
                            Margin="12,0,0,0" Padding="8,4" FontSize="11"
                            Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Options & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Target Winner Count Picker -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⭐ 순위" FontSize="12" FontWeight="Bold" Foreground="#E4E4E7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CbWinnerCount" Width="74" Height="28" FontSize="12" FontWeight="Bold"
                                  Background="#27272A" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="1명" IsSelected="True"/>
                            <ComboBoxItem Content="2명"/>
                            <ComboBoxItem Content="3명"/>
                            <ComboBoxItem Content="4명"/>
                            <ComboBoxItem Content="5명"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- View Results Button -->
                    <Button x:Name="BtnViewResult" Content="결과 보기" Click="BtnViewResult_Click"
                            Padding="12,6" Margin="0,0,10,0" Height="30"
                            Background="#EA580C" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Monitor Switcher -->
                    <Button x:Name="BtnSwitchMonitor" Content="📺 모니터 2" Click="BtnSwitchMonitor_Click"
                            Padding="10,6" Margin="0,0,8,0" Height="30"
                            Background="#27272A" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Exclude Picked Checkbox -->
                    <CheckBox x:Name="ChkExcludePicked" Content="뽑힌 학생 제외" IsChecked="True" Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. MAIN 3-PANEL PLAYFIELD -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Minimap (180px) -->
                <ColumnDefinition Width="180" />
                <!-- Center: Main Race Camera Viewport (*) -->
                <ColumnDefinition Width="*" />
                <!-- Right: Leaderboard (220px default, resizable up to 580px) -->
                <ColumnDefinition x:Name="ColLeaderboard" Width="220" MinWidth="180" MaxWidth="580" />
            </Grid.ColumnDefinitions>

            <!-- 2-A. LEFT PANEL: 전체맵 (MINIMAP) -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🗺️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="전체맵" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minimap Box (전체 5개 구간 및 코스가 한눈에 보이는 고화질 미니맵) -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" BorderBrush="#334155" BorderThickness="1.5" ClipToBounds="True">
                        <Canvas x:Name="MinimapCanvas" Width="154" Height="620" ClipToBounds="True">
                            <!-- 5개 구역 배경 레이어 -->
                            <!-- 1. High-resolution rendered Minimap Background matching the full 3500px track -->
                            <Image Source="pack://application:,,,/assets/race/race_minimap_bg.png" Width="154" Height="620" IsHitTestVisible="False"/>

                            <!-- Live dots representing students on minimap -->
                            <Canvas x:Name="MinimapDotsLayer" Width="154" Height="620"/>

                            <!-- Current Camera Viewport Finder Box -->
                            <Border x:Name="MinimapViewportBox" Canvas.Left="0" Canvas.Top="0" Width="154" Height="150"
                                    BorderBrush="#FDE047" BorderThickness="2" Background="#20FDE047" IsHitTestVisible="False" CornerRadius="4"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- 2-B. CENTER PANEL: MAIN RACE CAMERA VIEWPORT -->
            <Grid Grid.Column="1" x:Name="RaceViewport" ClipToBounds="True" Background="#0D1520" SizeChanged="RaceViewport_SizeChanged">
                <ScrollViewer x:Name="RaceScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Top"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="RaceScrollViewer_PreviewMouseWheel">

                    <Grid x:Name="RaceWorld" Width="680" Height="3500" HorizontalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="RaceWorldScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <!-- Main Playfield Canvas (3500px 긴 레이스 트랙) -->
                        <Canvas x:Name="RaceCanvas" Width="680" Height="3500" ClipToBounds="True">

                            <!-- ================================================= -->
                            <!-- UNIFIED HIGH-RESOLUTION RACE TRACK BACKGROUND     -->
                            <!-- ================================================= -->
                            <Image Canvas.Left="0" Canvas.Top="0" Width="680" Height="3500"
                                   Source="pack://application:,,,/assets/race/race_track_bg.png"
                                   IsHitTestVisible="False"/>

                            <!-- ================================================= -->
                            <!-- START BANNER (출발 축하 페스티벌 아치 배너)         -->
                            <!-- ================================================= -->
                            <Image Canvas.Left="40" Canvas.Top="85" Width="600" Height="90"
                                   Source="pack://application:,,,/assets/race/cartoon_start_banner.png"/>

                            <!-- ================================================= -->
                            <!-- FINISH WATER SLIDE & CELEBRATION DOCK             -->
                            <!-- ================================================= -->

                            <!-- 결승 수로 동적 물보라 (골인 시 애니메이션 발동) -->
                            <Image x:Name="ImgWaterSplash" Canvas.Left="270" Canvas.Top="3330" Width="140" Height="70"
                                   Source="pack://application:,,,/assets/race/cartoon_water_splash.png"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>

                            <!-- DYNAMIC OBSTACLES, SQUIRRELS, BALLS ARE ADDED HERE -->
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- 🎥 Floating Camera Viewpoint Control HUD -->
                <Border x:Name="BorderCameraHud" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Background="#E60F172A" CornerRadius="18"
                        BorderBrush="#38BDF8" BorderThickness="1.5" Padding="8,4"
                        Panel.ZIndex="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Prev Rank Button -->
                        <Button x:Name="BtnCameraPrevRank" Click="BtnCameraPrevRank_Click"
                                Content="◀" Width="26" Height="26" Background="#1E293B" Foreground="#38BDF8"
                                FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="이전 등수로 시점 이동 (PageUp)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                        </Button>

                        <TextBlock Text="🎥" FontSize="13" VerticalAlignment="Center" Margin="2,0,4,0"/>
                        <TextBlock Text="시점:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <!-- Rank Selection ComboBox -->
                        <ComboBox x:Name="CbCameraRank" SelectionChanged="CbCameraRank_SelectionChanged"
                                  Width="120" Height="26" FontSize="11" FontWeight="Bold"
                                  Background="#1E293B" Foreground="#FDE047" BorderBrush="#334155"
                                  VerticalContentAlignment="Center" Margin="0,0,4,0" Cursor="Hand"
                                  ToolTip="시점을 맞출 등수를 선택하세요 (1등, 2등, 3등, 14등, 꼴등 등)">
                        </ComboBox>

                        <!-- Next Rank Button -->
                        <Button x:Name="BtnCameraNextRank" Click="BtnCameraNextRank_Click"
                                Content="▶" Width="26" Height="26" Background="#1E293B" Foreground="#38BDF8"
                                FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"
                                ToolTip="다음 등수로 시점 이동 (PageDown)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                        </Button>

                        <!-- Quick 1st Place Reset Button -->
                        <Button x:Name="BtnCameraReset1st" Click="BtnCameraReset1st_Click"
                                Content="🥇 1등 복귀" Padding="8,2" Height="26"
                                Background="#EA580C" Foreground="White" FontWeight="Bold" FontSize="11"
                                BorderThickness="0" Cursor="Hand" Margin="2,0,2,0"
                                ToolTip="1등(선두) 자동 추적 시점으로 즉시 복귀 (Home 키)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ⏸️ 일시정지 오버레이 배너 -->
                <Border x:Name="BorderPausedBanner" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#D90F172A" CornerRadius="20" BorderBrush="#F59E0B" BorderThickness="2.5"
                        Padding="36,20" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="⏸ " FontSize="24" Foreground="#FDE047" VerticalAlignment="Center"/>
                            <TextBlock Text="레이스 일시정지됨" FontSize="22" FontWeight="Bold" Foreground="#FDE047" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="[이어하기] 버튼 또는 [스페이스바]를 누르면 레이스가 계속 진행됩니다." FontSize="14" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 🏆 Compact Floating Winner Celebration Toast (레이스를 가리지 않는 상단 토스트 알림) -->
                <Border x:Name="GridCelebration" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                        Background="#F20F172A" CornerRadius="20" BorderBrush="#F59E0B" BorderThickness="2.5"
                        Padding="18,10" Width="430" Height="76" Panel.ZIndex="30" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Color="#F59E0B" Opacity="0.9" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>

                        <!-- Winner Avatar with golden ring -->
                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25"
                                Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="2"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image x:Name="ImgWinnerAvatar" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Title & Student Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="🥇 1등 골인! 당첨을 축하합니다!" FontSize="12" FontWeight="Bold" Foreground="#FDE047"/>
                            <TextBlock x:Name="TxtWinnerTitle" Text="7번 김민준 (판다)" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Sparkle Emoji -->
                        <TextBlock Grid.Column="2" Text="🎉" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Resizable GridSplitter between Viewport and Leaderboard -->
                <GridSplitter Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              Background="#1E293B" Cursor="SizeWE" ShowsPreview="False" Panel.ZIndex="25"/>
            </Grid>

            <!-- 2-C. RIGHT PANEL: 실시간 순위표 (LEADERBOARD) -->
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0" Padding="10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="실시간 순위표" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Toggle 1-Column / 2-Column Expand Button -->
                            <Button x:Name="BtnToggleLeaderboardWidth" Click="BtnToggleLeaderboardWidth_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="⤢ 2열 확대" Padding="6,2" Height="24"
                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                    FontSize="11" FontWeight="Bold" Cursor="Hand"
                                    ToolTip="순위표를 2열로 넓혀 모든 학생을 한눈에 봅니다">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                        <TextBlock Text="클릭 시 해당 학생으로 시점 전환 (경계선 드래그 조절 가능)" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Scrollable Live Ranks List (1열/2열 적응형 그리드) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="GridLeaderboardContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColRank1" Width="*" />
                                <ColumnDefinition x:Name="ColRank2" Width="0" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PanelLeaderboardCol1" Grid.Column="0" Margin="0,0,2,0"/>
                            <StackPanel x:Name="PanelLeaderboardCol2" Grid.Column="1" Margin="2,0,0,0"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. BOTTOM CONTROL BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Shortcuts Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 단축키: " FontSize="12" Foreground="#71717A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="Space (출발/정지)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="PgUp/PgDn (시점)" FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                    </Border>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Esc (닫기)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                    </Border>
                </StackPanel>

                <!-- Center: 4 Big Control Buttons (Start, Pause/Resume, Reset, Re-select) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Re-select Button -->
                    <Button x:Name="BtnResetToStart" Content="← 처음으로" Click="BtnResetToStart_Click"
                            Width="110" Height="44" Background="#27272A" Foreground="White"
                            FontWeight="Bold" FontSize="13" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                    </Button>

                    <!-- Giant Orange Start Button -->
                    <Button x:Name="BtnStartRace" Click="BtnStartRace_Click"
                            Width="160" Height="48" Background="#EA580C" Foreground="White"
                            FontWeight="Bold" FontSize="18" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="24"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="18" Color="#EA580C" Opacity="0.6"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶ " FontSize="16"/>
                            <TextBlock x:Name="TxtBtnStartLabel" Text="시작하기"/>
                        </StackPanel>
                    </Button>

                    <!-- ⏸️ / ▶️ Pause / Resume Button -->
                    <Button x:Name="BtnPauseResume" Click="BtnPauseResume_Click" IsEnabled="False"
                            Width="130" Height="44" Background="#27272A" Foreground="#FDE047"
                            FontWeight="Bold" FontSize="13" BorderBrush="#EAB308" BorderThickness="1.5" Cursor="Hand" Margin="0,0,10,0" ToolTip="스페이스바 또는 클릭하여 일시정지/이어하기">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPauseIcon" Text="⏸ " FontSize="14"/>
                            <TextBlock x:Name="TxtPauseLabel" Text="일시정지"/>
                        </StackPanel>
                    </Button>

                    <!-- Reset Button -->
                    <Button x:Name="BtnInitAll" Content="↺ 초기화하기" Click="BtnInitAll_Click"
                            Width="110" Height="44" Background="#27272A" Foreground="#A1A1AA"
                            FontWeight="Bold" FontSize="13" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Speed, Sound & Student Manage -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Speed Multiplier (1x / 2x / 3x) -->
                    <Button x:Name="BtnSpeedToggle" Content="> 1x" Click="BtnSpeedToggle_Click"
                            Width="56" Height="34" Margin="0,0,8,0"
                            Background="#27272A" Foreground="#FDE047" BorderBrush="#3F3F46" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="레이스 배속 (1x / 2x / 3x)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <!-- Sound Volume & Mute Controls -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="6,0" Margin="0,0,8,0" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sound Mute/Unmute Toggle -->
                            <Button x:Name="BtnSoundToggle" Content="🔇" Click="BtnSoundToggle_Click"
                                    Width="26" Height="26" Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                    FontWeight="Bold" FontSize="13" Cursor="Hand" ToolTip="레이스 배경음악 켜기 (기본: 음소거)" Padding="0"/>
                            <!-- Volume Slider -->
                            <Slider x:Name="SliderSoundVolume" Width="68" Minimum="0" Maximum="100" Value="0"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center" Margin="4,0,4,0"
                                    ValueChanged="SliderSoundVolume_ValueChanged" ToolTip="효과음/배경음 볼륨 조절" Cursor="Hand"/>
                            <!-- Volume Text -->
                            <TextBlock x:Name="TxtSoundVolume" Text="OFF" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="28" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- Manage Roster -->
                    <Button Content="👥 학생 명단" Click="BtnManageRoster_Click"
                            Padding="10,0" Height="34"
                            Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="32종 동물 아바타 및 학생 명단 관리">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
