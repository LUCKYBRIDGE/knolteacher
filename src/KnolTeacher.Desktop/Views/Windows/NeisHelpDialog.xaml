<Window x:Class="KnolTeacher.Desktop.Views.Windows.NeisHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 나이스(NEIS) 평어 일괄입력 상세 사용 가이드"
        Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#F8F5EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="나이스(NEIS) 평어 일괄입력 완벽 가이드" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="행동특성 및 종합의견, 교과학습발달상황, 창의적체험활동 평어를 엑셀에서 나이스로 가장 쉽고 안전하게 입력하는 방법입니다." FontSize="11" Foreground="#3B82F6" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- STEP 1: 엑셀 준비 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E7DAC7" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#10B981" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="STEP 1" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="엑셀 평어 작성 및 준비" FontWeight="Bold" FontSize="14" Foreground="#1C1917" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="• 상단의 [📥 표준 엑셀 양식 다운로드] 버튼을 눌러 양식을 받으시거나, 기존 엑셀 파일을 준비합니다." FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <TextBlock Text="• 필수 열: [번호], [성명], [평어내용] 3개 열만 있으면 순서와 상관없이 자동으로 인식합니다." FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <TextBlock Text="• 엑셀 셀들을 마우스로 드래그하여 Ctrl+C(복사)한 뒤, 놀티쳐의 [📋 엑셀 복사내용 바로 붙여넣기]를 누르면 파일 저장 없이도 즉시 입력됩니다!" FontSize="12" Foreground="#047857" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2: 바이트 자동 검증 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E7DAC7" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#F59E0B" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="STEP 2" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="4세대 나이스 규격(바이트) 실시간 자동 검증" FontWeight="Bold" FontSize="14" Foreground="#1C1917" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="• 4세대 나이스 규정(한글 1글자=3바이트, 공백·영문=1바이트, 줄바꿈=2바이트)에 맞게 실시간 계산됩니다." FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <TextBlock Text="• 1,500 Byte를 초과한 학생은 표에 ⚠️ [초과] 경고로 표시되므로, 나이스에서 '글자 수 초과'로 저장이 거부되는 문제를 사전에 100% 방지할 수 있습니다." FontSize="12" Foreground="#B45309" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- STEP 3: 2가지 입력 방식 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E7DAC7" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#2563EB" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="STEP 3" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="나이스에 입력하기 (원하는 방식을 선택하세요)" FontWeight="Bold" FontSize="14" Foreground="#1C1917" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Method 1 Card -->
                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 [방식 1] 나이스 1초 일괄 완성 (개발자도구 콘솔 방식 · 강력 추천!)" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                                    <Border Background="#DBEAFE" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                        <TextBlock Text="오탈자 0% · 밀림 0% · 1초 완성" FontSize="10" Foreground="#1E40AF" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="1. 놀티쳐에서 [🚀 나이스 1초 일괄입력 코드 복사] 버튼을 누릅니다." FontSize="11" Foreground="#1E3A8A" Margin="0,6,0,2"/>
                                <TextBlock Text="2. 인터넷 브라우저(Chrome/Edge)의 나이스 화면에서 키보드 [F12] 키를 누릅니다." FontSize="11" Foreground="#1E3A8A" Margin="0,0,0,2"/>
                                <TextBlock Text="3. 열린 개발자도구 창 상단의 [Console] (콘솔) 탭을 클릭합니다." FontSize="11" Foreground="#1E3A8A" Margin="0,0,0,2"/>
                                <TextBlock Text="4. 콘솔 입력창에 Ctrl+V 붙여넣기 후 [Enter]를 누르면 전교생 평어가 1초 만에 번호별로 자동 쏙 입력됩니다!" FontSize="11" Foreground="#1D4ED8" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Method 2 Card -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖱️ [방식 2] 플로팅 순차 도우미 (단축키 F8 자동 콕콕 입력)" FontWeight="Bold" FontSize="13" Foreground="#15803D"/>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                        <TextBlock Text="화면 보면서 확인 입력" FontSize="10" Foreground="#166534" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="1. 놀티쳐에서 [🖱️ 플로팅 순차 입력 도우미 실행]을 누릅니다." FontSize="11" Foreground="#14532D" Margin="0,6,0,2"/>
                                <TextBlock Text="2. 나이스 창 위에 작은 미니 도우미가 항상 떠 있습니다." FontSize="11" Foreground="#14532D" Margin="0,0,0,2"/>
                                <TextBlock Text="3. 나이스의 1번 학생 칸을 마우스로 클릭하고, 키보드 [F8] 키만 누르면 즉시 평어가 붙여넣어지고 다음 학생으로 자동 이동합니다!" FontSize="11" Foreground="#15803D" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="4. [▶ 1.5초 간격 자동 순차 입력] 버튼을 누르면 자동으로 다음 칸으로 넘어가며 전원 연속 입력도 가능합니다." FontSize="11" Foreground="#14532D"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 4: 저장 및 확인 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E7DAC7" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#6B7280" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="STEP 4" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="나이스 상단 [저장] 버튼 클릭" FontWeight="Bold" FontSize="14" Foreground="#1C1917" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="• 평어가 모두 정상 입력되었는지 눈으로 확인하신 후, 나이스 상단의 [저장] 버튼을 클릭하면 완료됩니다." FontSize="12" Foreground="#44403C"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Close Button -->
        <Button Grid.Row="2" Content="확인했습니다" Click="BtnClose_Click" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
        </Button>
    </Grid>
</Window>