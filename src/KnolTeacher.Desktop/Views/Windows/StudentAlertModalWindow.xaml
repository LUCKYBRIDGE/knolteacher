<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentAlertModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="교실 알림"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC0F172A"
        WindowState="Normal"
        Topmost="True"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="30">
        <!-- Main Centered Presentation Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="960" MinWidth="680"
                Background="#1E293B"
                BorderBrush="#38BDF8" BorderThickness="2.5"
                CornerRadius="24" Padding="40,36">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="12" Opacity="0.75"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Badge: Category/Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#0284C7" CornerRadius="14" Padding="16,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderIcon" Text="📢" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderBadge" Text="교실 전체 알림" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Title & Big Emoji -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtMainEmoji" Text="🧹" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtTitle" Text="교실 청소 및 하교 지도 시간"
                               FontSize="34" FontWeight="Bold" Foreground="#F8FAFC"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <!-- Message Body -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1.5"
                        Padding="24,18" Margin="0,0,0,24">
                    <TextBlock x:Name="TxtMessage"
                               Text="주변을 깨끗이 정돈하고 사물함과 개인 소지품을 챙겨 안전하게 하교 준비를 합시다."
                               FontSize="20" FontWeight="SemiBold" Foreground="#CBD5E1"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="32"/>
                </Border>

                <!-- Timer Panel (Optional, Visible when ShowTimer is true) -->
                <StackPanel x:Name="PanelTimer" Grid.Row="3" Margin="0,0,0,24" Visibility="Visible">
                    <!-- Countdown Digits -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtTimerDigits" Text="10:00"
                                   FontFamily="Consolas, Segoe UI, Malgun Gothic"
                                   FontSize="64" FontWeight="Bold" Foreground="#38BDF8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtOverdueDigits" Text="(-0:00)"
                                   FontFamily="Consolas, Segoe UI, Malgun Gothic"
                                   FontSize="36" FontWeight="Bold" Foreground="#EF4444"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="PbTimerProgress" Height="10" Value="100" Maximum="100"
                                 Background="#334155" Foreground="#0284C7" Margin="20,0,20,14">
                        <ProgressBar.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </ProgressBar.Resources>
                    </ProgressBar>

                    <!-- Timer Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPauseTimer" Click="BtnPauseTimer_Click"
                                Content="일시정지" Height="36" Padding="16,0" Margin="0,0,8,0"
                                Background="#334155" Foreground="White" FontWeight="Bold" FontSize="13"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnAddMinute" Click="BtnAddMinute_Click"
                                Content="+1분 연장" Height="36" Padding="14,0" Margin="0,0,8,0"
                                Background="#0369A1" Foreground="White" FontWeight="Bold" FontSize="13"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnResetTimer" Click="BtnResetTimer_Click"
                                Content="처음부터" Height="36" Padding="14,0"
                                Background="#334155" Foreground="#94A3B8" FontWeight="Bold" FontSize="13"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="BtnClose_Click"
                            Content="✕ 창 닫기 (ESC)"
                            Height="44" Padding="28,0"
                            Background="#DC2626" Foreground="White"
                            FontWeight="Bold" FontSize="15"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
