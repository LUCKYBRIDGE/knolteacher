<Window x:Class="KnolTeacher.Desktop.Views.Windows.SmartSeatShuffleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🪑 스마트 자리 바꾸기 - 놀티쳐"
        Height="760" Width="1020"
        MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BeigeAppBg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 1. Header & Configuration Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Blackboard / Podium Indicator -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Classroom Desks Grid Area -->
            <RowDefinition Height="*"/>
            <!-- 4. Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Layout Controls -->
        <Border Grid.Row="0" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🪑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="스마트 자리 바꾸기" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="32종 동물 아바타 연동" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="행·열 그리드 맞춤형 책상 배치 및 두근두근 셔플 애니메이션을 지원합니다." FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Top Right Options -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Preset Buttons -->
                    <Button Content="👫 짝 대형 (4×6)" Click="BtnPresetPairs_Click" Padding="8,5" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="👥 모둠 대형 (4×6)" Click="BtnPresetGroups_Click" Padding="8,5" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="🏫 시험 대형 (5×5)" Click="BtnPresetExams_Click" Padding="8,5" Margin="0,0,8,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnTogglePerspective" Content="🔄 시선 전환 (칠판/교탁)" Click="BtnTogglePerspective_Click" Padding="8,5" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="학생 시선(칠판 앞쪽) ↔ 교사 시선(교탁 앞쪽) 상하 반전 전환">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="📺 모니터 2" Click="BtnSwitchMonitor_Click" Padding="8,5" Margin="0,0,4,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="학생용 TV/프로젝터로 자리 배치표 이동">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnFullscreen" Content="⛶ 전체화면" Click="BtnFullscreen_Click" Padding="8,5" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Blackboard Banner -->
        <Border Grid.Row="1" x:Name="BannerBoard" Background="#14532D" BorderBrush="#166534" BorderThickness="2" CornerRadius="8" Padding="14,6" Margin="40,0,40,10" HorizontalAlignment="Stretch">
            <Grid>
                <TextBlock x:Name="TxtBoardTitle" Text="🟩  칠  판  (앞 쪽)  🟩" FontWeight="Bold" FontSize="14" Foreground="#BBF7D0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtClassSizeInfo" Text="재적: 24명" FontSize="11" Foreground="#86EFAC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. Classroom Desks Grid -->
        <Border Grid.Row="2" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="GridDesks" Rows="4" Columns="6" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Desk items dynamically added in code-behind -->
                </UniformGrid>
            </ScrollViewer>
        </Border>

        <!-- 4. Bottom Controls & Shuffle Button -->
        <Border Grid.Row="3" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Grid Dimension Adjusters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="가로(열):" FontSize="12" Foreground="{DynamicResource BeigeTextSub}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboCols" Width="48" Height="28" SelectionChanged="Dimensions_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="세로(행):" FontSize="12" Foreground="{DynamicResource BeigeTextSub}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboRows" Width="48" Height="28" SelectionChanged="Dimensions_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="ChkGenderPair" Content="남/여 짝꿍 우선" IsChecked="False" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="남학생-여학생을 짝꿍으로 우선 배치"/>
                    <CheckBox x:Name="ChkRollingAnimation" Content="두근두근 롤링 셔플" IsChecked="True" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" ToolTip="3초간 아바타가 돌아가며 긴장감 넘치게 배치"/>
                </StackPanel>

                <!-- Shuffle Button & Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 배치표 복사" Click="BtnCopySeating_Click" Padding="12,7" Margin="0,0,8,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnShuffle" Content="🎲 자리 바꾸기 시작!" Click="BtnShuffle_Click" Padding="20,8" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
