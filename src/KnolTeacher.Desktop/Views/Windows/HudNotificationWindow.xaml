<Window x:Class="KnolTeacher.Desktop.Views.Windows.HudNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Grid Margin="16">
        <Border x:Name="HudBorder"
                Background="#E60F172A"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                CornerRadius="18"
                Padding="16,8"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.4" ShadowDepth="3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtIcon" Text="🔔" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtMessage" Text="알림 메시지" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
