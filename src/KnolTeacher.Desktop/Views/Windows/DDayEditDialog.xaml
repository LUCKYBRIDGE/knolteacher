<Window x:Class="KnolTeacher.Desktop.Views.Windows.DDayEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="학급 D-Day 설정" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A" Foreground="White"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎯" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="학급 D-Day 목표일 설정" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="학생 화면(놀보드)과 메인 대시보드에 표시될 목표일을 지정합니다." FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Body -->
        <StackPanel Grid.Row="1">
            <!-- Event Title Input -->
            <TextBlock Text="목표 행사 / 일정명" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
            <TextBox x:Name="TbTitle" Height="32" Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="13" Text="여름방학" Margin="0,0,0,8" TextChanged="TbTitle_TextChanged"/>

            <!-- Quick Presets -->
            <WrapPanel Margin="0,0,0,14">
                <Button Content="여름방학" Click="BtnPreset_Click" Tag="여름방학" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="겨울방학" Click="BtnPreset_Click" Tag="겨울방학" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="현장체험학습" Click="BtnPreset_Click" Tag="현장체험학습" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="체육대회" Click="BtnPreset_Click" Tag="체육대회" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="학예회" Click="BtnPreset_Click" Tag="학예회" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="단원평가" Click="BtnPreset_Click" Tag="단원평가" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="종업식" Click="BtnPreset_Click" Tag="종업식" Margin="0,0,4,4" Padding="6,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
            </WrapPanel>

            <!-- Target Date Picker -->
            <TextBlock Text="목표 일자 (D-Day)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
            <DatePicker x:Name="DpTargetDate" Height="32" Margin="0,0,0,12" SelectedDateChanged="DpTargetDate_SelectedDateChanged"/>

            <!-- Realtime Preview Pill -->
            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TxtPreviewDDay" Text="D-14" DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Foreground="#FDE047" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPreviewTitle" Text="여름방학" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtPreviewDate" Text="2026-07-24" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Click="BtnCancel_Click" Width="80" Height="34" Margin="0,0,8,0" Background="#334155" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="💾 저장 및 적용" Click="BtnSave_Click" Width="120" Height="34" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
