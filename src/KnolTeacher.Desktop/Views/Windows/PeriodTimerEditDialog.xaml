<Window x:Class="KnolTeacher.Desktop.Views.Windows.PeriodTimerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="교시별 예비 타이머 설정"
        Height="650" Width="660"
        MinHeight="580" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BeigeAppBg}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <!-- Top Header & Period Info -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable Settings -->
            <RowDefinition Height="*" />
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Period Info -->
        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="⏱️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtHeaderTitle" Text="2교시 (사회) 시작 전 타이머 설정" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}"/>
                        <Border x:Name="BadgePeriod" Background="{DynamicResource BeigeAccent}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBadgePeriod" Text="2교시" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderTimeRange" Text="수업 시간: 10:00 ~ 10:40 (시작 전 학생 화면에 카운트다운 타이머 표출)" FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="⚡ 10초 테스트" Click="BtnTestRun_Click" Padding="12,6" Background="{DynamicResource BeigeAccentSoft}" Foreground="{DynamicResource BeigeAccent}" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="학생 화면에 10초 카운트다운을 즉시 띄워봅니다.">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Scrollable Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Section 1: Activation & Mode -->
                <Border Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnabled" Content="이 교시 시작 전 예비 카운트다운 타이머 사용" IsChecked="True" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkUseGlobal" Content="🌐 전체 일괄 기본값 따르기 (체크 해제 시 이 교시만 단독 설정)" Click="ChkUseGlobal_Click" IsChecked="False" FontWeight="SemiBold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,4"/>
                        <TextBlock Text="* 전체 일괄 기본값을 따를 경우 '전체 예비령 설정'의 시간과 문구가 자동 적용됩니다." FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Timer Duration & Lead Time -->
                <Border x:Name="PanelCustomTimeSettings" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⏱️ 타이머가 켜지는 시각 &amp; 총 작동 시간" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Start Lead (타이머가 켜지는 시각) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. 타이머 켜지는 시각 (시작 시점):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="수업 시작" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TbStartMin" Text="5" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                    <TextBlock Text="분" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <TextBox x:Name="TbStartSec" Text="00" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                    <TextBlock Text="초 전부터" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="▶" FontSize="16" Foreground="{DynamicResource BeigeAccent}" VerticalAlignment="Center" Margin="10,0"/>

                            <!-- End Lead (타이머 목표 종료 시각) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="2. 타이머 목표 (종료 시점):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="수업 시작" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TbEndMin" Text="0" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                    <TextBlock Text="분" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <TextBox x:Name="TbEndSec" Text="00" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                    <TextBlock Text="초 전까지" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Preset Quick Buttons for Duration & Classroom Travel -->
                        <TextBlock Text="⚡ 수업 형태 선택 (클릭 시 기본값 자동 적용):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="BtnPresetClassroom" Content="🏫 교실 수업 (기본 5분 전)" Click="BtnPresetTravel_Click" Tag="classroom" Padding="12,6" Margin="0,0,8,6" Background="#ECFDF5" Foreground="#059669" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" ToolTip="일반 교실 수업 (기본 5분 전 시작 ~ 3분 전 종료)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="BtnPresetTravel" Content="🎒 이동 수업 (기본 10분 전)" Click="BtnPresetTravel_Click" Tag="travel" Padding="12,6" Margin="0,0,8,6" Background="#EEF2FF" Foreground="#4F46E5" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" ToolTip="과학실, 미술실, 체육관 등 이동수업 (기본 10분 전 시작 ~ 3분 전 종료)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </WrapPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="💡 특정 이동수업의 경우 위 1, 2번에서 분·초를 직접 입력하여 원하는 시간(예: 8분 전, 12분 전 등)으로 자유롭게 수동 조정할 수 있습니다." FontSize="11" Foreground="#0284C7" LineHeight="16"/>
                        </Border>

                        <!-- Calculated Duration Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBlock x:Name="TxtCalculatedDuration" Text="💡 화면에 대형 타이머가 총 5분 00초 동안 카운트다운됩니다." FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 3: Notice Messages -->
                <Border Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💬 타이머와 함께 띄울 안내 메시지" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TbPreNotice" Text="🔔 다음 시간 {교시} ({과목}) 준비 시간입니다! 자리에 앉아 교과서를 펴주세요." Height="36" FontSize="12" Padding="10,6" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                        <!-- Preset Quick Buttons for Messages -->
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="📖 교과서 준비" Click="BtnPresetMessage_Click" Tag="🔔 다음 시간 {교시} ({과목}) 준비 시간입니다! 자리에 앉아 교과서를 펴주세요." Padding="8,3" Margin="0,0,6,6" Background="#F1F5F9" Foreground="#334155" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="🎒 이동수업/특별실" Click="BtnPresetMessage_Click" Tag="🎒 다음 시간은 {과목} 이동수업입니다! 필요한 준비물을 챙겨 조용히 이동합시다." Padding="8,3" Margin="0,0,6,6" Background="#F1F5F9" Foreground="#334155" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="🧹 주변 정리" Click="BtnPresetMessage_Click" Tag="🧹 책상 위와 주변을 깨끗이 정리하고 다음 {과목} 수업을 준비합시다." Padding="8,3" Margin="0,0,6,6" Background="#F1F5F9" Foreground="#334155" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="💻 태블릿 준비" Click="BtnPresetMessage_Click" Tag="💻 태블릿과 학습 도구를 켜고 {과목} 수업 준비를 마칩시다." Padding="8,3" Margin="0,0,6,6" Background="#F1F5F9" Foreground="#334155" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="💬 타이머 종료 시 띄울 착석 완료 문구" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TbPostNotice" Text="👏 수업 준비 완료! 자리에 모두 착석했습니다." Height="36" FontSize="12" Padding="10,6" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                        <CheckBox x:Name="ChkSoundChime" Content="카운트다운 종료 시 차임벨 재생" IsChecked="True" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BeigeTextMain}"/>
                    </StackPanel>
                </Border>

                <!-- Section 4: Display Monitor -->
                <Border Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖥️ 타이머를 띄울 모니터 선택" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CbMonitorSelect" Height="32" FontSize="12">
                            <ComboBoxItem Content="📺 2번 모니터 (학생용 전자칠판 / TV) (권장)" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="💻 1번 주 모니터 (교사용 PC 본 화면)" Tag="0"/>
                            <ComboBoxItem Content="🖱️ 현재 마우스 커서가 위치한 모니터" Tag="-1"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="⏱️ 40분 타이머 바로 실행" Click="BtnLaunchClassTimer_Click" Height="36" Padding="12,0" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="수업 진행 중 일반 집중 타이머를 엽니다.">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="🌐 전체 일괄 설정..." Click="BtnOpenGlobalSettings_Click" Height="36" Padding="12,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMuted}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="🗑️ 이 교시 알람 삭제(끄기)" Click="BtnDeleteAlarm_Click" Height="36" Padding="14,0" Margin="10,0,0,0" HorizontalAlignment="Left" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="이 교시의 시작 전 예비 알람을 완전히 끕니다.">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="3" Content="취소" Click="BtnCancel_Click" Height="36" Padding="16,0" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="4" Content="설정 저장하기" Click="BtnSave_Click" Height="36" Padding="18,0" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
