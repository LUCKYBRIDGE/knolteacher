<Window x:Class="KnolTeacher.Desktop.Views.Windows.AutoNoticeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시간대별 자동 알림 &amp; 알림장 세트 관리"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⏰" FontSize="20" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="스마트 일과 연동 알림장 &amp; 프리셋 세트" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="등교/수업/쉬는시간/점심/하교 시간에 맞춰 공지를 자동 전환하고, 자주 쓰는 알림장을 세트로 관리합니다." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content (Tabs) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: 시간대별 자동 알림장 -->
            <TabItem Header="🕒 시간대별 자동 공지" FontSize="12" FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkEnableAutoNotice" Content="시간대별 알림장 자동 전환 기능 사용"
                                          Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🌅 1. 아침 등교 시간 문구 (08:30~09:00)" Foreground="#CBD5E1" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMorning" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="📖 2. 수업 중 문구 (각 교시 수업 시간)" Foreground="#CBD5E1" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtClass" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="⚽ 3. 쉬는 시간 문구 (수업 사이 10분)" Foreground="#CBD5E1" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBreak" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="🍱 4. 점심 시간 문구" Foreground="#CBD5E1" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLunch" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="🎒 5. 하교 시간 문구" Foreground="#CBD5E1" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDismissal" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 알림장 프리셋 세트 관리 -->
            <TabItem Header="📁 알림장 세트 묶음" FontSize="12" FontWeight="Bold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="TxtNewSetName" Width="240" Height="32" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,8,0" Tag="세트 이름 입력..."/>
                        <Button Content="＋ 현재 내용을 새 세트로 저장" Click="BtnSaveCurrentAsSet_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,0" Height="32" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                        <ListBox x:Name="ListBoardSets" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ListBoardSets_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                            <TextBlock Text="{Binding Content}" FontSize="11" Foreground="#94A3B8" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="📥 선택한 세트 적용" Click="BtnApplySet_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="🗑️ 삭제" Click="BtnDeleteSet_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장 &amp; 닫기" Click="BtnSaveAndClose_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="20,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="취소" Click="BtnCancel_Click" Background="#334155" Foreground="#CBD5E1" FontWeight="Bold" Padding="16,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
