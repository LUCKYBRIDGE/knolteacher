<Window x:Class="KnolTeacher.Desktop.Views.Windows.TemplateShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📋 놀티쳐 데이터 양식 다운로드 &amp; 공유 센터"
        Height="680" Width="880"
        MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app_icon.ico"
        Background="{DynamicResource BeigeAppBg}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="데이터 양식 다운로드 &amp; 공유 센터" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Excel / CSV 호환 • 100% 로컬 보안" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="학생 명렬표, 학사일정, 주간 시간표 양식을 내려받아 작성하거나, 동료 교사와 공유 파일을 주고받아 로컬에 즉시 반영하세요." FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="✕ 닫기" Click="BtnClose_Click" Padding="14,6" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="12" FontWeight="Bold" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
            <!-- Card 1: 학생 명렬표 -->
            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStudentCountBadge" Text="현재 20명 등록" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎓" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="학생 명렬표 (CSV)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="번호, 이름, 성별, 비고 컬럼으로 구성된 엑셀 호환 CSV 양식입니다. 학급 학생 명단을 한 번에 등록하여 추첨, 모둠 편성, 자리바꾸기에 활용하세요." FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" TextWrapping="Wrap" LineHeight="17"/>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
                        <Button x:Name="BtnExportStudent" Click="BtnExportStudent_Click" Content="📥 양식 다운로드" Padding="10,8" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnImportStudent" Click="BtnImportStudent_Click" Content="📤 파일 업로드" Padding="10,8" Margin="4,0,0,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Card 2: 학사일정 & D-Day -->
            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtScheduleCountBadge" Text="학사일정 연동" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="학사일정 &amp; D-Day (CSV)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="날짜, 일정명, 휴업여부, D-Day 표시 여부가 포함된 양식입니다. 방학식, 개교기념일, 현장체험학습 등 1년 학사일정을 캘린더와 D-Day 위젯에 바로 반영합니다." FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" TextWrapping="Wrap" LineHeight="17"/>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
                        <Button x:Name="BtnExportSchedule" Click="BtnExportSchedule_Click" Content="📥 양식 다운로드" Padding="10,8" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnImportSchedule" Click="BtnImportSchedule_Click" Content="📤 파일 업로드" Padding="10,8" Margin="4,0,0,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Card 3: 주간 시간표 -->
            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="월~금 1~6교시" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏰" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="주간 시간표 (CSV)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="교시별(1~6교시) 월/화/수/목/금 수업 과목이 정리된 CSV 양식입니다. 학년별 시간표를 작성하여 업로드하면 메인 시간표 위젯과 예비령 시스템에 즉각 반영됩니다." FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" TextWrapping="Wrap" LineHeight="17"/>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
                        <Button x:Name="BtnExportTimetable" Click="BtnExportTimetable_Click" Content="📥 양식 다운로드" Padding="10,8" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnImportTimetable" Click="BtnImportTimetable_Click" Content="📤 파일 업로드" Padding="10,8" Margin="4,0,0,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Card 4: 환경설정 종합 백업/공유 패키지 -->
            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text=".knolcfg 종합" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="놀티쳐 설정 패키지" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="메인화면 위젯 크기·배치 설정, 수업 예비령 알림, 놀보드 위젯 세트, 학생 명렬을 통째로 압축 백업하거나, 동료 교사의 설정을 그대로 복원합니다." FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" TextWrapping="Wrap" LineHeight="17"/>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
                        <Button x:Name="BtnExportFullConfig" Click="BtnExportFullConfig_Click" Content="💾 내 설정 내보내기" Padding="10,8" Margin="0,0,4,0" Background="{DynamicResource BeigeCardInner}" Foreground="#6D28D9" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnImportFullConfig" Click="BtnImportFullConfig_Click" Content="📂 설정 불러오기" Padding="10,8" Margin="4,0,0,0" Background="#6D28D9" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusMessage" Text="파일을 이 창 위로 끌어다 놓으면(Drag &amp; Drop) 자동으로 양식을 감지하여 로컬에 반영합니다." FontSize="11.5" Foreground="{DynamicResource BeigeTextSub}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="※ 개인정보는 외부 전송 없이 PC 로컬에만 저장됩니다." FontSize="10.5" Foreground="{DynamicResource BeigeTextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
