<Window x:Class="KnolTeacher.Desktop.Views.Windows.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="스마트 플로팅 독 (Alt+9)"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DockButtonStyle}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Floating Capsule Container with Shadow -->
        <Border Background="#F20F172A"
                CornerRadius="22"
                BorderBrush="#475569"
                BorderThickness="1"
                Padding="10,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.45" ShadowDepth="4" Color="#000000"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Drag Grip -->
                <TextBlock Text="⋮⋮" FontSize="14" FontWeight="Bold" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="2,0,8,0" Cursor="SizeAll"
                           ToolTip="클릭하고 드래그하여 독 이동"/>

                <!-- Brand Logo -->
                <Image Source="/assets/app_icon.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Quick Tool Buttons -->
                <Button x:Name="BtnBoard" Style="{StaticResource DockAccentButtonStyle}" Click="BtnBoard_Click" ToolTip="놀보드 열기 (F2)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📺 " FontSize="12"/>
                        <TextBlock Text="놀보드"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnDraw" Style="{StaticResource DockButtonStyle}" Click="BtnDraw_Click" ToolTip="화면 전체 판서 (Alt+2)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️ " FontSize="12"/>
                        <TextBlock Text="판서"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnTimer" Style="{StaticResource DockButtonStyle}" Click="BtnTimer_Click" ToolTip="교실 집중 타이머 (Alt+3)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱️ " FontSize="12"/>
                        <TextBlock Text="타이머"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnVisualizer" Style="{StaticResource DockButtonStyle}" Click="BtnVisualizer_Click" ToolTip="스마트 실물화상기">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📷 " FontSize="12"/>
                        <TextBlock Text="화상기"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPicker" Style="{StaticResource DockButtonStyle}" Click="BtnPicker_Click" ToolTip="발표자 추첨기 (Alt+8)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲 " FontSize="12"/>
                        <TextBlock Text="추첨"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnQr" Style="{StaticResource DockButtonStyle}" Click="BtnQr_Click" ToolTip="QR코드 생성기">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱 " FontSize="12"/>
                        <TextBlock Text="QR코드"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnZen" Style="{StaticResource DockButtonStyle}" Click="BtnZen_Click" ToolTip="바탕화면 아이콘 숨김 / 수업 집중 모드">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🙈 " FontSize="12"/>
                        <TextBlock Text="바탕숨김" Foreground="#FDE047"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Separator Margin="2,4,8,4" Background="#334155"/>

                <!-- Close Button -->
                <Button Click="BtnClose_Click" Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="독 닫기 (Alt+9)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bClose" CornerRadius="13" Background="Transparent">
                                <TextBlock Text="✕" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bClose" Property="Background" Value="#DC2626"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
