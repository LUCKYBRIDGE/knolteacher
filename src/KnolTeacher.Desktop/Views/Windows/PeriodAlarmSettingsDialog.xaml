<Window x:Class="KnolTeacher.Desktop.Views.Windows.PeriodAlarmSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔔 수업 시작 전 예비령 &amp; 대형 카운트다운 타이머 설정"
        Height="700" Width="820"
        MinHeight="580" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8F5EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & System Guide -->
            <RowDefinition Height="Auto" />
            <!-- Settings Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & System Guide Callout -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🔔 수업 시작 전 예비령 &amp; 대형 카운트다운 설정" FontSize="18" FontWeight="Bold" Foreground="#1C1917"/>
            <Border Background="#FEF3C7" CornerRadius="8" BorderBrush="#F59E0B" BorderThickness="1" Padding="12,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="💡 예비령 &amp; 카운트다운 동작 원리:" FontWeight="Bold" FontSize="12" Foreground="#92400E"/>
                    <TextBlock Text="• '수업 시작 5분 00초 전 ~ 3분 00초 전'으로 설정하면, 수업 시작 5분 전에 지정된 모니터에 대형 타이머가 자동으로 뜨고 2분 동안 카운트다운이 시작됩니다.&#x0a;• 카운트다운이 끝나면(3분 전 도달) 종료음이 울리며 착석 완료 문구가 표시됩니다. 분 단위와 초 단위 모두 미세 조정 가능합니다."
                               FontSize="11" Foreground="#78350F" LineHeight="17" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Settings Tabs -->
        <TabControl x:Name="AlarmTabs" Grid.Row="1" Background="White" BorderBrush="#E7DAC7" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: 일괄 기본 설정 -->
            <TabItem Header="🌐 전체 일괄 기본 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Enable Checkbox -->
                        <CheckBox x:Name="ChkGlobalEnabled" Content="수업 시작 전 예비 카운트다운 알람 시스템 사용" IsChecked="True" FontWeight="Bold" FontSize="13" Foreground="#1C1917" Margin="0,0,0,16"/>

                        <!-- Timing Section (Minutes + Seconds) -->
                        <Border Background="#FAF7F2" CornerRadius="8" BorderBrush="#E7DAC7" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⏱️ 카운트다운 실행 시점 (분·초 단위 정밀 설정)" FontWeight="Bold" FontSize="12" Foreground="#44403C" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Lead -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="1. 타이머 화면 표시 (시작 시점):" FontSize="11" Foreground="#78716C" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="수업 시작" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="TbStartMin" Text="5" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                            <TextBlock Text="분" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                            <TextBox x:Name="TbStartSec" Text="00" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                            <TextBlock Text="초 전부터" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="▶" FontSize="16" Foreground="#B45309" VerticalAlignment="Center" Margin="10,0"/>

                                    <!-- End Lead -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="2. 카운트다운 목표 (종료 시점):" FontSize="11" Foreground="#78716C" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="수업 시작" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="TbEndMin" Text="3" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                            <TextBlock Text="분" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                            <TextBox x:Name="TbEndSec" Text="00" Width="36" Height="30" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="TimeCalc_TextChanged"/>
                                            <TextBlock Text="초 전까지" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Calculated Duration Badge -->
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="10,6">
                                    <TextBlock x:Name="TxtCalculatedDuration" Text="💡 화면에 대형 타이머가 2분 00초 동안 카운트다운됩니다." FontWeight="Bold" FontSize="12" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Monitor Selector -->
                        <TextBlock Text="🖥️ 타이머를 띄울 모니터 선택" FontWeight="Bold" FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbMonitorSelect" Height="32" MinHeight="32" FontSize="12" Margin="0,0,0,14">
                            <ComboBoxItem Content="🖱️ 현재 마우스 커서가 위치한 모니터 (권장)" Tag="-1" IsSelected="True"/>
                            <ComboBoxItem Content="1️⃣ 1번 주 모니터 (교사용 PC 본 화면)" Tag="0"/>
                            <ComboBoxItem Content="2️⃣ 2번 보조 모니터 (전자칠판 / 학생 디스플레이)" Tag="1"/>
                        </ComboBox>

                        <!-- Notice Text Inputs -->
                        <TextBlock Text="💬 카운트다운 동안 크게 띄울 안내 문구 (사전 설정)" FontWeight="Bold" FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbPreNotice" Text="🔔 다음 시간 {교시} ({과목}) 준비 시간입니다! 자리에 앉아 교과서를 펴주세요." Height="34" FontSize="12" Padding="8,4" Margin="0,0,0,10"/>
                        <TextBlock Text="* 문구 내 {교시}와 {과목}은 실제 시간표의 교시와 과목명으로 자동 치환됩니다." FontSize="10" Foreground="#78716C" Margin="0,0,0,14"/>

                        <TextBlock Text="💬 카운트다운 종료 시 띄울 완료 문구" FontWeight="Bold" FontSize="12" Foreground="#44403C" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbPostNotice" Text="👏 수업 준비 완료! 자리에 모두 착석했습니다." Height="34" FontSize="12" Padding="8,4" Margin="0,0,0,14"/>

                        <!-- Options & Test Button -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkSoundChime" Content="카운트다운 종료 시 차임벨 재생" IsChecked="True" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <TextBlock Text="종료 후 자동 닫힘:" FontSize="11" Foreground="#78716C" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TbAutoCloseSec" Text="8" Width="30" Height="26" FontSize="11" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                <TextBlock Text="초" FontSize="11" Foreground="#78716C" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="⚡ 지금 10초 테스트 미리보기" Click="BtnTestRun_Click" Height="34" Padding="14,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: 교시별 개별 맞춤 설정 (1~7교시) -->
            <TabItem Header="📅 교시별 개별 맞춤 설정 (1~7교시)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="특정 교시(예: 점심 후 5교시나 아침 1교시)에만 다른 예비 시간이나 문구를 지정할 수 있습니다." FontSize="11" Foreground="#78716C" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ListPeriodOverrides">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAF7F2" CornerRadius="8" BorderBrush="#E7DAC7" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Period Title & Use Global Toggle -->
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#B45309" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                    </Border>
                                                    <CheckBox IsChecked="{Binding Enabled}" Content="알람 켜기" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <CheckBox IsChecked="{Binding UseGlobal}" Content="🌐 일괄 기본값 사용" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 1: Custom Settings (collapsed if UseGlobal == true) -->
                                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseGlobal}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="시작:" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Text="{Binding LeadStartMinutes}" Width="28" Height="24" FontSize="11" TextAlignment="Center"/>
                                                        <TextBlock Text="분" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                        <TextBox Text="{Binding LeadStartSeconds}" Width="28" Height="24" FontSize="11" TextAlignment="Center"/>
                                                        <TextBlock Text="초 전" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="종료:" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Text="{Binding LeadEndMinutes}" Width="28" Height="24" FontSize="11" TextAlignment="Center"/>
                                                        <TextBlock Text="분" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                        <TextBox Text="{Binding LeadEndSeconds}" Width="28" Height="24" FontSize="11" TextAlignment="Center"/>
                                                        <TextBlock Text="초 전" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBox Text="{Binding PreNoticeText}" Height="28" FontSize="11" Padding="4,2" Margin="0,0,0,4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="↺ 기본값으로 초기화" Click="BtnResetDefaults_Click" Height="36" Padding="12,0" Background="#E7DAC7" Foreground="#44403C" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="취소" Click="BtnCancel_Click" Height="36" Padding="16,0" Margin="0,0,6,0" Background="#E7DAC7" Foreground="#44403C" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Grid.Column="3" Content="설정 저장하기" Click="BtnSave_Click" Height="36" Padding="18,0" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
