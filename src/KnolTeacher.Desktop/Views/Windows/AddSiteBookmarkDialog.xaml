<Window x:Class="KnolTeacher.Desktop.Views.Windows.AddSiteBookmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나만의 교육 사이트 추가" 
        Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BeigeWindowBg}">

    <Border Padding="24" Background="{DynamicResource BeigeWindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="⭐ 나만의 즐겨찾기 사이트 등록" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}"/>
                <TextBlock Text="자주 방문하시는 사이트의 이름과 웹 주소를 입력하세요." FontSize="11" Foreground="{DynamicResource BeigeTextSub}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- 1. Name -->
                <TextBlock Text="사이트 이름 (필수)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                <TextBox x:Name="TbTitle" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" FontSize="12" Margin="0,0,0,12"/>

                <!-- 2. URL -->
                <TextBlock Text="웹사이트 URL 주소 (필수)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                <TextBox x:Name="TbUrl" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" FontSize="12" Margin="0,0,0,12" Text="https://"/>

                <!-- 3. Description -->
                <TextBlock Text="간단한 메모 또는 설명" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                <TextBox x:Name="TbDesc" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" FontSize="12" Margin="0,0,0,12"/>

                <!-- 4. Icon Picker -->
                <TextBlock Text="대표 아이콘 선택" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,6"/>
                <WrapPanel x:Name="PnlIcons" Margin="0,0,0,12">
                    <RadioButton Content="⭐" GroupName="IconGroup" IsChecked="True" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="📚" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="🌐" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="💡" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="🏫" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="🎨" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="💻" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                    <RadioButton Content="📝" GroupName="IconGroup" FontSize="16" Margin="0,0,10,0" Cursor="Hand"/>
                </WrapPanel>
            </StackPanel>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="취소" Click="BtnCancel_Click" Padding="16,8" Margin="0,0,8,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="등록하기" Click="BtnAdd_Click" Padding="20,8" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
