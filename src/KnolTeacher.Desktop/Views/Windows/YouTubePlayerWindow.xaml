<Window x:Class="KnolTeacher.Desktop.Views.Windows.YouTubePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="🎵 교실 무광고 유튜브 BGM &amp; 영상 플레이어"
        Height="680" Width="960"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header & Playlist Bar -->
            <RowDefinition Height="Auto" />
            <!-- Video / Audio Surface -->
            <RowDefinition Height="*" />
            <!-- Controls & Section Repeat Panel -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Track Selector -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🎵" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="보관함:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CbPlaylist" Width="260" Height="30" MinHeight="30" FontSize="11" Padding="6,2" VerticalContentAlignment="Center" SelectionChanged="CbPlaylist_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNowPlaying" Text="재생할 음악을 선택하세요" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ 링크 등록" Click="BtnAddLink_Click" Height="30" Padding="10,0" Margin="0,0,4,0" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="🗑️ 삭제" Click="BtnDeleteTrack_Click" Height="30" Padding="8,0" Margin="0,0,4,0" Background="#334155" Foreground="#CBD5E1" FontSize="11" Cursor="Hand" ToolTip="현재 선택된 음악 목록에서 삭제">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnAudioModeToggle" Content="🎧 오디오 모드" Click="BtnAudioModeToggle_Click" Height="30" Padding="8,0" Background="#334155" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Ad-Free Player Viewport -->
        <Border Grid.Row="1" x:Name="PlayerBorder" Background="Black" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,10">
            <wv2:WebView2 x:Name="WebPlayer" />
        </Border>

        <!-- Controls & A-B Section Repeat -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14,10">
            <StackPanel>
                <!-- Line 1: Seek Slider & Time -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCurrentTime" Grid.Column="0" Text="00:00" FontFamily="Consolas" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="SliderProgress" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" PreviewMouseDown="SliderProgress_PreviewMouseDown" PreviewMouseUp="SliderProgress_PreviewMouseUp"/>
                    <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00" FontFamily="Consolas" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Line 2: Playback Actions & A-B Repeat Configuration -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Standard Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮️" Click="BtnPrev_Click" Width="34" Height="30" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                        <Button x:Name="BtnPlayPause" Content="▶" Click="BtnPlayPause_Click" Width="44" Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                        <Button Content="⏭️" Click="BtnNext_Click" Width="34" Height="30" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                        <!-- Loop toggle -->
                        <ToggleButton x:Name="ToggleLoop" Content="🔁 반복" Click="ToggleLoop_Click" IsChecked="True" Height="30" Padding="8,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    </StackPanel>

                    <!-- Center: A-B Section Repeat Controls -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="8,4" Margin="10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔂 구간반복:" Foreground="#FDE047" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            
                            <!-- Point A -->
                            <Button Content="[A설정]" Click="BtnSetPointA_Click" Height="24" Padding="4,0" Background="#334155" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="현재 재생 시점을 A(시작)로 설정"/>
                            <TextBox x:Name="TbStartSec" Text="00:00" Width="44" Height="24" FontSize="11" FontFamily="Consolas" TextAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="3,0,6,0" LostFocus="SectionTime_LostFocus"/>

                            <!-- Point B -->
                            <Button Content="[B설정]" Click="BtnSetPointB_Click" Height="24" Padding="4,0" Background="#334155" Foreground="#EF4444" FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="현재 재생 시점을 B(종료)로 설정"/>
                            <TextBox x:Name="TbEndSec" Text="00:00" Width="44" Height="24" FontSize="11" FontFamily="Consolas" TextAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="3,0,8,0" LostFocus="SectionTime_LostFocus"/>

                            <!-- Enable Checkbox -->
                            <CheckBox x:Name="ChkEnableSection" Content="구간 반복 켜기" Checked="ChkEnableSection_Changed" Unchecked="ChkEnableSection_Changed" Foreground="#FDE047" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Volume Slider -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="SliderVolume" Width="80" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" ValueChanged="SliderVolume_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
