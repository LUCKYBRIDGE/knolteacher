<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="놀보드 (학생용 올인원 인터랙티브 보드)" Height="850" Width="1350"
        Icon="/assets/board_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Control Toolbar -->
            <RowDefinition Height="52" />
            <!-- Main Board Surface (Canvas & Ink) -->
            <RowDefinition Height="*" />
            <!-- Bottom Dock Toolbar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Control Toolbar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Clock -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 놀보드" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="8,4" Margin="0,0,14,0">
                        <TextBlock x:Name="TxtClock" Text="09:00:00" FontFamily="Consolas, Malgun Gothic" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <!-- Center: Presets & Widgets & Board Themes & Drawing -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Preset Modes -->
                        <TextBlock Text="모드:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="🎯 수업도구" Click="BtnPresetTools_Click" Padding="8,4" Margin="0,0,4,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="📋 학급게시판" Click="BtnPresetBoard_Click" Padding="8,4" Margin="0,0,4,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="⚖️ 올인원" Click="BtnPresetSplit_Click" Padding="8,4" Margin="0,0,10,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <!-- Add Widget Dropdown -->
                        <TextBlock Text="+ 위젯:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CbAddWidget" Width="136" Height="32" MinHeight="32" FontSize="11" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,12,0" SelectionChanged="CbAddWidget_SelectionChanged">
                            <ComboBoxItem Content="위젯 선택..." IsSelected="True"/>
                            <ComboBoxItem Content="⏱️ 수업 타이머" Tag="timer"/>
                            <ComboBoxItem Content="🎯 발표자 추첨" Tag="picker"/>
                            <ComboBoxItem Content="🎲 스마트 주사위" Tag="dice"/>
                            <ComboBoxItem Content="🎡 돌려돌려 돌림판" Tag="wheel"/>
                            <ComboBoxItem Content="🏆 모둠 점수판" Tag="score"/>
                            <ComboBoxItem Content="✏️ 칠판 판서장" Tag="drawing"/>
                            <ComboBoxItem Content="📅 오늘의 시간표" Tag="timetable"/>
                            <ComboBoxItem Content="🍱 오늘의 급식" Tag="meal"/>
                            <ComboBoxItem Content="📝 학급 알림장" Tag="memo"/>
                            <ComboBoxItem Content="📱 실시간 QR코드" Tag="qr"/>
                        </ComboBox>

                        <Separator Margin="0,8,12,8" Background="#475569"/>

                        <!-- Board Themes -->
                        <Button Content="🏫 칠판" Click="BtnGreenBoard_Click" Padding="6,4" Margin="0,0,4,0" Background="#1B4332" Foreground="White" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="📋 화이트" Click="BtnWhiteBoard_Click" Padding="6,4" Margin="0,0,4,0" Background="#F8F9FA" Foreground="#0F172A" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button Content="🌙 다크" Click="BtnDarkBoard_Click" Padding="6,4" Margin="0,0,12,0" Background="#0F172A" Foreground="White" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>

                        <Separator Margin="0,8,12,8" Background="#475569"/>

                        <!-- Drawing Overlay Mode -->
                        <ToggleButton x:Name="ToggleInkMode" Content="✏️ 전체 화면 판서" Checked="ToggleInkMode_Checked" Unchecked="ToggleInkMode_Unchecked" Padding="8,4" Margin="0,0,8,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></ToggleButton.Resources>
                        </ToggleButton>

                        <StackPanel x:Name="PanelInkTools" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton x:Name="RbPen" Content="펜" IsChecked="True" Checked="RbPen_Checked" Foreground="White" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbEraser" Content="지우개" Checked="RbEraser_Checked" Foreground="White" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Width="18" Height="18" Background="White" Click="BtnColor_Click" Tag="#FFFFFF" Margin="0,0,3,0" Cursor="Hand"/>
                            <Button Width="18" Height="18" Background="#FDE047" Click="BtnColor_Click" Tag="#FDE047" Margin="0,0,3,0" Cursor="Hand"/>
                            <Button Width="18" Height="18" Background="#F472B6" Click="BtnColor_Click" Tag="#F472B6" Margin="0,0,3,0" Cursor="Hand"/>
                            <Button Width="18" Height="18" Background="#38BDF8" Click="BtnColor_Click" Tag="#38BDF8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="↩" Click="BtnUndo_Click" Padding="6,2" Margin="0,0,3,0" Background="#475569" Foreground="White" FontSize="11" Cursor="Hand"/>
                            <Button Content="🗑" Click="BtnClear_Click" Padding="6,2" Background="#EF4444" Foreground="White" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Window Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔲 전체화면" Click="BtnFullscreen_Click" Margin="0,0,6,0" Padding="8,4" Background="#334155" Foreground="White" FontSize="11" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="✕ 닫기 (F2)" Click="BtnClose_Click" Padding="8,4" Background="#DC2626" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Board Surface Area -->
        <Grid Grid.Row="1" x:Name="BoardContainer" Background="#1B4332">
            <!-- Widgets Canvas (Movable & Resizable Widgets Layer) -->
            <Canvas x:Name="WidgetCanvas" ClipToBounds="True" Background="Transparent"/>

            <!-- Transparent Ink Canvas Overlay for Drawing Mode -->
            <InkCanvas x:Name="BoardInkCanvas"
                       Background="Transparent"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- 3. Bottom Dock Toolbar (파이썬 놀티쳐 완벽 계승 9대 도구 스위치 & 자동 정렬) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Handle Bar (Fold/Unfold) -->
                    <RowDefinition Height="24" />
                    <!-- Dock Body -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Handle Bar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="아래 버튼을 눌러 원하는 도구 위젯을 보드 위에 띄우거나 끕니다 (자유 이동 및 크기 조절)" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleDock" Content="▼ 도구 바 접기" Click="BtnToggleDock_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#64748B" FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="6,2"/>
                    </Grid>
                </Border>

                <!-- Dock Body -->
                <Border Grid.Row="1" x:Name="DockBody" Padding="10,6" Background="#0B0F19">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: 9 Widget Toggle Buttons -->
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button x:Name="BtnToolTimer" Content="⏱️ 타이머" Click="DockToolBtn_Click" Tag="timer" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolPicker" Content="🎯 발표자 추첨" Click="DockToolBtn_Click" Tag="picker" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolDice" Content="🎲 주사위·통계" Click="DockToolBtn_Click" Tag="dice" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolWheel" Content="🎡 돌림판" Click="DockToolBtn_Click" Tag="wheel" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolScore" Content="🏆 모둠 점수판" Click="DockToolBtn_Click" Tag="score" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolDrawing" Content="✏️ 칠판·판서" Click="DockToolBtn_Click" Tag="drawing" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolTimetable" Content="📅 시간표" Click="DockToolBtn_Click" Tag="timetable" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolMeal" Content="🍱 급식" Click="DockToolBtn_Click" Tag="meal" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolMemo" Content="📝 알림장" Click="DockToolBtn_Click" Tag="memo" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            <Button x:Name="BtnToolQr" Content="📱 QR코드" Click="DockToolBtn_Click" Tag="qr" Height="32" Padding="10,0" Margin="0,2,6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" Cursor="Hand" ToolTip="수업 링크 및 자료 실시간 QR코드 생성 &amp; 학생 공유"/>
                        </WrapPanel>

                        <!-- Right: Layout & Close Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnTileWidgets" Content="📐 자동 정렬" Click="BtnTileWidgets_Click" Height="32" Padding="12,0" Margin="4,2,4,2" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="열려 있는 위젯들을 화면에 바둑판 형태로 자동 정렬"/>
                            <Button x:Name="BtnCloseAllWidgets" Content="🧹 전체 닫기" Click="BtnCloseAllWidgets_Click" Height="32" Padding="12,0" Margin="4,2,0,2" Background="#1E293B" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1" FontSize="11" Cursor="Hand" ToolTip="보드 위의 모든 위젯 닫기"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
