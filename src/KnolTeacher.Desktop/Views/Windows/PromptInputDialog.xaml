<Window x:Class="KnolTeacher.Desktop.Views.Windows.PromptInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입력" Height="190" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F5EE">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" Grid.Row="0" Text="입력해 주세요:" FontSize="13" FontWeight="Bold" Foreground="#1C1917" Margin="0,0,0,10"/>

        <TextBox x:Name="TbInput" Grid.Row="1" Height="34" FontSize="13" Padding="8,4" Background="White" BorderBrush="#DBCDBA" VerticalAlignment="Top"/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="취소" Click="BtnCancel_Click" Grid.Column="0" Height="34" Margin="0,0,4,0" Background="#E7DAC7" Foreground="#44403C" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="확인" Click="BtnOk_Click" Grid.Column="1" Height="34" Margin="4,0,0,0" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
