<Window x:Class="KnolTeacher.Desktop.Views.Windows.HotkeySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⌨️ 단축키 맞춤 커스텀 설정"
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8F5EE">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Description -->
            <RowDefinition Height="Auto" />
            <!-- Hotkey List -->
            <RowDefinition Height="*" />
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⌨️ 단축키(Alt+1~9) 맞춤 설정" FontSize="18" FontWeight="Bold" Foreground="#1C1917" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="선생님이 원하는 조합으로 단축키를 자유롭게 변경할 수 있습니다. 변경된 설정은 즉시 전역 반영됩니다." FontSize="12" Foreground="#78716C" Margin="0,0,0,14"/>

        <!-- Hotkey List Container -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E7DAC7" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListHotkeys">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAF7F2" CornerRadius="8" BorderBrush="#E7DAC7" BorderThickness="1" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Enable Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Action Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1C1917"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#78716C" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Modifier Input -->
                                    <ComboBox Grid.Column="2" SelectedValue="{Binding Modifier}" SelectedValuePath="Content" Width="85" Height="30" MinHeight="30" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0">
                                        <ComboBoxItem Content="Alt"/>
                                        <ComboBoxItem Content="Ctrl"/>
                                        <ComboBoxItem Content="Shift"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>

                                    <!-- Key Input -->
                                    <TextBox Grid.Column="3" Text="{Binding Key}" Width="65" Height="30" FontSize="12" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="#DBCDBA"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="↺ 기본값으로 복원" Click="BtnResetDefaults_Click" Height="36" Padding="12,0" Background="#E7DAC7" Foreground="#44403C" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="취소" Click="BtnCancel_Click" Height="36" Padding="16,0" Margin="0,0,6,0" Background="#E7DAC7" Foreground="#44403C" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Grid.Column="3" Content="설정 저장하기" Click="BtnSave_Click" Height="36" Padding="18,0" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
