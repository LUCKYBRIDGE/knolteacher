<Window x:Class="KnolTeacher.Desktop.Views.Windows.ScreenDrawingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="스마트 화면 &amp; 칠판 판서 (Alt+2)"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Solid / Grid Board Background -->
        <Border x:Name="BoardBackground" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Background Freeze Image -->
        <Image x:Name="FreezeImage" Stretch="Fill" />

        <!-- GPU Accelerated InkCanvas for instant, lag-free drawing -->
        <InkCanvas x:Name="OverlayInkCanvas"
                   Background="Transparent" />

        <!-- Overlay Tools Canvas for Ruler, Triangle, Protractor -->
        <Canvas x:Name="OverlayToolsCanvas"
                Background="Transparent"
                IsHitTestVisible="True" />

        <!-- 1. Floating Top Toolbar (Draggable, 2-Row / 1-Row Smart Layout, Non-clipping) -->
        <Border x:Name="ToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#F00F172A" CornerRadius="16"
                BorderBrush="#334155" BorderThickness="1.5"
                Padding="12,8"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown"
                MouseMove="Toolbar_MouseMove"
                MouseLeftButtonUp="Toolbar_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.65" ShadowDepth="4" Color="#000000"/>
            </Border.Effect>

            <!-- Main Container for Rows -->
            <StackPanel x:Name="ToolbarMainStack" Orientation="Vertical">
                <!-- ROW 1: Board Modes, Pen Tools, Stroke Width & Color Swatches -->
                <StackPanel x:Name="PanelRow1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <!-- Drag Handle & Title -->
                    <TextBlock Text="⠿" FontSize="14" Foreground="#64748B" Cursor="SizeAll" Margin="2,0,6,0" VerticalAlignment="Center" ToolTip="클릭 후 드래그하여 도구 모음 위치 이동 (더블클릭 시 접기)"/>
                    <TextBlock x:Name="TxtStudioTitle" Text="✏️ 판서 스튜디오" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5"/>

                    <!-- Background Modes (원터치 배경 전환) -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbBgScreen" Content="🖼️ 화면" IsChecked="True" Checked="RbBg_Checked" Tag="screen" Foreground="White" FontSize="11" Margin="0,0,4,0" Cursor="Hand" ToolTip="현재 화면 캡처 정지 주석"/>
                            <RadioButton x:Name="RbBgChalkboard" Content="🟩 칠판" Checked="RbBg_Checked" Tag="chalkboard" Foreground="White" FontSize="11" Margin="0,0,4,0" Cursor="Hand" ToolTip="아늑한 초록칠판 판서 모드"/>
                            <RadioButton x:Name="RbBgWhiteboard" Content="⬜ 화이트" Checked="RbBg_Checked" Tag="whiteboard" Foreground="White" FontSize="11" Margin="0,0,4,0" Cursor="Hand" ToolTip="깔끔한 화이트보드 판서 모드"/>
                            <RadioButton x:Name="RbBgGrid" Content="📐 모눈" Checked="RbBg_Checked" Tag="grid" Foreground="White" FontSize="11" Cursor="Hand" ToolTip="수학·도형 수업용 모눈종이 판서 모드"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,2,6,2" Width="1" Background="#334155"/>

                    <!-- Tool Toggles -->
                    <RadioButton x:Name="RbPen" Content="펜" IsChecked="True" Checked="RbPen_Checked" Foreground="White" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <RadioButton x:Name="RbHighlighter" Content="형광펜" Checked="RbHighlighter_Checked" Foreground="White" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <RadioButton x:Name="RbEraser" Content="지우개" Checked="RbEraser_Checked" Foreground="White" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"/>

                    <!-- Pen Thickness Selection -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="3,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="●" FontSize="7" Click="BtnStrokeWidth_Click" Tag="2" Width="19" Height="19" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" ToolTip="얇게 (2pt)"/>
                            <Button Content="●" FontSize="10" Click="BtnStrokeWidth_Click" Tag="4" Width="19" Height="19" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" ToolTip="보통 (4pt)"/>
                            <Button Content="●" FontSize="14" Click="BtnStrokeWidth_Click" Tag="8" Width="19" Height="19" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" ToolTip="굵게 (8pt)"/>
                            <Button Content="●" FontSize="18" Click="BtnStrokeWidth_Click" Tag="16" Width="19" Height="19" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" ToolTip="아주 굵게 (16pt)"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Colors -->
                    <Button Width="18" Height="18" Background="#EF4444" Click="BtnColor_Click" Tag="#EF4444" Margin="0,0,3,0" ToolTip="빨강" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>
                    <Button Width="18" Height="18" Background="#FDE047" Click="BtnColor_Click" Tag="#FDE047" Margin="0,0,3,0" ToolTip="노랑" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>
                    <Button Width="18" Height="18" Background="#38BDF8" Click="BtnColor_Click" Tag="#38BDF8" Margin="0,0,3,0" ToolTip="하늘" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>
                    <Button Width="18" Height="18" Background="#22C55E" Click="BtnColor_Click" Tag="#22C55E" Margin="0,0,3,0" ToolTip="초록" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>
                    <Button Width="18" Height="18" Background="#FFFFFF" Click="BtnColor_Click" Tag="#FFFFFF" Margin="0,0,3,0" ToolTip="흰색" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>
                    <Button Width="18" Height="18" Background="#1E293B" BorderBrush="#64748B" BorderThickness="1" Click="BtnColor_Click" Tag="#1E293B" Margin="0,0,8,0" ToolTip="검정" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                    </Button>

                    <Separator Margin="0,2,6,2" Width="1" Background="#334155"/>

                    <!-- 1-Row / 2-Row Layout Toggle Button -->
                    <Button x:Name="BtnToggleRowLayout" Content="↕ 1줄로" Click="BtnToggleRowLayout_Click" Margin="0,0,4,0" Padding="7,3" Background="#1E293B" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" ToolTip="툴바를 1줄 / 2줄로 전환하여 표시"/>

                    <!-- Fold / Collapse Button -->
                    <Button x:Name="BtnFoldToolbar" Content="▲ 접기" Click="BtnFoldToolbar_Click" Padding="8,3" Background="#0369A1" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="화면을 넓게 활용하기 위해 도구창 접기"/>
                </StackPanel>

                <!-- ROW 2: Math Tools, Save / Folder Actions, Undo, Clear, Exit -->
                <StackPanel x:Name="PanelRow2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="수업도구:" Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,6,0"/>

                    <!-- Math 교구 Tools -->
                    <Button Content="📏 자" Click="BtnToggleRuler_Click" Margin="0,0,4,0" Padding="8,3" Background="#334155" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="0~20cm 직선자 (각도 회전 및 측정)"/>
                    <Button Content="📐 삼각자" Click="BtnToggleTriangle_Click" Margin="0,0,4,0" Padding="8,3" Background="#334155" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="45°-45°-90° 삼각자"/>
                    <Button Content="🧭 각도기" Click="BtnToggleProtractor_Click" Margin="0,0,8,0" Padding="8,3" Background="#334155" Foreground="#FDE047" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="180° 반원 각도기"/>

                    <Separator Margin="0,2,6,2" Width="1" Background="#334155"/>

                    <!-- Actions: Save, Folder, Change Location -->
                    <Button Content="💾 저장" Click="BtnSaveDrawing_Click" Margin="0,0,4,0" Padding="9,4" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="지정된 폴더에 즉시 저장 및 클립보드 복사"/>
                    <Button Content="📁 폴더 열기" Click="BtnOpenSaveFolder_Click" Margin="0,0,4,0" Padding="7,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="판서가 저장된 폴더를 윈도우 탐색기로 즉시 열기"/>
                    <Button Content="⚙️ 저장위치" Click="BtnChangeSaveFolder_Click" Margin="0,0,8,0" Padding="6,4" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="10.5" Cursor="Hand" ToolTip="판서 및 파일의 기본 저장 폴더 변경"/>

                    <Separator Margin="0,2,6,2" Width="1" Background="#334155"/>

                    <!-- Undo & Clear -->
                    <Button Content="↩ 실행취소" Click="BtnUndo_Click" Margin="0,0,4,0" Padding="8,4" Background="#334155" Foreground="White" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="마지막 판서 한 획 취소"/>
                    <Button Content="🗑 지우기" Click="BtnClear_Click" Margin="0,0,8,0" Padding="8,4" Background="#DC2626" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" ToolTip="현재 판서 전체 지우기"/>

                    <Separator Margin="0,2,6,2" Width="1" Background="#334155"/>

                    <!-- Exit -->
                    <Button Content="✕ 판서 종료 (ESC)" Click="BtnClose_Click" Padding="10,4" Background="#E11D48" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="판서 스튜디오 종료 (단축키: ESC)"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Mini Collapsed Floating Pill Bar (접기 모드 전용 초소형 플로팅 뱃지) -->
        <Border x:Name="MiniToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Background="#F00F172A" CornerRadius="16"
                BorderBrush="#38BDF8" BorderThickness="1.5"
                Padding="10,4"
                Visibility="Collapsed"
                MouseLeftButtonDown="MiniToolbar_MouseLeftButtonDown"
                MouseMove="MiniToolbar_MouseMove"
                MouseLeftButtonUp="MiniToolbar_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MiniToolbarTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.7" ShadowDepth="3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="▼ ✏️ 판서 도구 펼치기" Click="BtnExpandToolbar_Click"
                        Background="Transparent" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                        ToolTip="접어둔 판서 도구창을 다시 펼칩니다"/>
                <Button Content="💾 저장" Click="BtnSaveDrawing_Click"
                        Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11"
                        Padding="8,3" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="현재 화면을 저장 폴더에 저장"/>
                <Button Content="✕ 판서 종료" Click="BtnClose_Click"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11"
                        Padding="8,3" BorderThickness="0" Cursor="Hand"
                        ToolTip="판서 스튜디오 종료 (ESC)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
