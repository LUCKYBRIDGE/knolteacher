<Window x:Class="KnolTeacher.Desktop.Views.Windows.SchoolScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="전국 학교 규모·통계"
        Height="700" Width="920"
        MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/assets/app_icon.ico"
        Background="{DynamicResource BeigeAppBg}">

    <Window.Resources>
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource BeigeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BeigeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 1. Window Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Main Workspace (List + Details) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Window Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏫" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="전국 학교 규모 · 통계 조회기" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="교육부 NEIS 공식 데이터 연동" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="전국 유·초·중·고·특수학교의 총 학급수, 학년별 학급 편성, 과밀/규모 등급 및 공시 통계를 실시간 조회합니다." FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- API Key Status & Config Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BadgeApiKeyStatus" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnConfigApiKey_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔑 NEIS API 키: " FontSize="11" Foreground="#166534" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtApiKeyStatus" Text="인증 활성화" FontSize="11" Foreground="#15803D" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnConfigApiKey" Content="키 설정" Click="BtnConfigApiKey_Click" Padding="10,5" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Search Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>

                <!-- Education Office Dropdown -->
                <ComboBox x:Name="ComboOffice" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource FilterComboStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="전체 교육청" Tag="ALL"/>
                    <ComboBoxItem Content="서울특별시 (B10)" Tag="B10"/>
                    <ComboBoxItem Content="부산광역시 (C10)" Tag="C10"/>
                    <ComboBoxItem Content="대구광역시 (D10)" Tag="D10"/>
                    <ComboBoxItem Content="인천광역시 (E10)" Tag="E10"/>
                    <ComboBoxItem Content="광주광역시 (F10)" Tag="F10"/>
                    <ComboBoxItem Content="대전광역시 (G10)" Tag="G10"/>
                    <ComboBoxItem Content="울산광역시 (H10)" Tag="H10"/>
                    <ComboBoxItem Content="세종특별자치시 (I10)" Tag="I10"/>
                    <ComboBoxItem Content="경기도 (J10)" Tag="J10"/>
                    <ComboBoxItem Content="강원특별자치도 (K10)" Tag="K10"/>
                    <ComboBoxItem Content="충청북도 (M10)" Tag="M10"/>
                    <ComboBoxItem Content="충청남도 (N10)" Tag="N10"/>
                    <ComboBoxItem Content="전북특별자치도 (P10)" Tag="P10"/>
                    <ComboBoxItem Content="전라남도 (Q10)" Tag="Q10"/>
                    <ComboBoxItem Content="경상북도 (R10)" Tag="R10"/>
                    <ComboBoxItem Content="경상남도 (S10)" Tag="S10"/>
                    <ComboBoxItem Content="제주특별자치도 (T10)" Tag="T10"/>
                </ComboBox>

                <!-- Keyword Input -->
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="TbSchoolQuery" Height="38" FontSize="13" Padding="12,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" VerticalContentAlignment="Center" KeyDown="TbSchoolQuery_KeyDown"/>
                    <TextBlock x:Name="TbWatermark" Text="학교 이름을 입력하세요 (예: 대치, 판교, 해송, 역삼, 목동 등)" FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <!-- Search Button -->
                <Button Grid.Column="2" Content="🔍 검색" Click="BtnSearch_Click" Height="38" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Main Workspace Split View -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Search Results List -->
            <Border Grid.Column="0" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtResultCount" Text="검색 결과" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}"/>
                    </Grid>

                    <ListBox x:Name="ListSearchResults" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ListSearchResults_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: School Name & Region -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding SchoolName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <!-- Mid Row: Badges -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,4">
                                            <Border Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding DisplayTypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding DisplayFondBadge}" FontSize="10" Foreground="#475569"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="{Binding DisplayShortRegion}" FontSize="10" Foreground="#475569"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Bottom Row: Address -->
                                        <TextBlock Grid.Row="2" Text="{Binding RoadAddress}" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Details Card -->
            <Border Grid.Column="1" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <!-- Empty State (No selection) -->
                    <StackPanel x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <TextBlock Text="🏫" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="학교명을 검색하여 선택하세요" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                        <TextBlock Text="좌측 검색창에 학교명을 입력하시면 학급수, 과밀/규모 등급,&#x0a;학년별 편성 통계 및 학교알리미 정보를 상세히 확인하실 수 있습니다." FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>

                    <!-- Loading Indicator -->
                    <StackPanel x:Name="PanelLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="⏳" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="학교 학급 규모 및 통계를 집계하고 있습니다..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Detail Content Container -->
                    <Grid x:Name="GridDetailView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- View Switcher Tabs: Stats vs Map -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnTabStats" Content="📊 학급 규모 &amp; 통계" Click="BtnTabStats_Click" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="BtnTabMap" Content="🗺️ 지도 위치 &amp; 주변 (OpenStreetMap)" Click="BtnTabMap_Click" Padding="12,6" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" FontWeight="Bold" FontSize="11" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📍 카카오맵 로드뷰" Click="BtnOpenKakaoMap_Click" Padding="8,5" Margin="0,0,6,0" Background="#FEE500" Foreground="#3C1E1E" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="카카오맵에서 고화질 로드뷰 및 길찾기 보기"/>
                                <Button Content="🌐 네이버 지도" Click="BtnOpenNaverMap_Click" Padding="8,5" Background="#03C75A" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="네이버 지도에서 보기"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Detail Content (Stats) OR Map View -->
                        <Grid Grid.Row="1">
                            <!-- Stats View -->
                            <ScrollViewer x:Name="ScrollDetailContent" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Top: School Header + Scale Badge -->
                                    <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtDetailSchoolName" Text="서울대치초등학교" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TxtDetailOffice" Text="서울특별시교육청" FontSize="12" Foreground="{DynamicResource BeigeTextSub}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtDetailJurisdiction" Text="강남서초교육지원청" FontSize="12" Foreground="{DynamicResource BeigeTextSub}"/>
                                        <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtDetailFondCoEdu" Text="공립 · 남여공학" FontSize="12" Foreground="{DynamicResource BeigeTextSub}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Scale Category Badge -->
                                <Border x:Name="BorderScaleBadge" Grid.Column="1" Background="#FEE2E2" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtScaleBadge" Text="🔴 과대학교 (과밀·대규모)" FontWeight="Bold" FontSize="12" Foreground="#991B1B"/>
                                </Border>
                            </Grid>

                            <!-- Scale Summary Box -->
                            <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <TextBlock x:Name="TxtScaleSummary" Text="총 48학급의 과대학교로, 학년당 평균 8학급 편성 및 학생 밀도가 매우 높습니다." FontSize="12" Foreground="{DynamicResource BeigeTextMain}" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>

                            <!-- 3-Column KPI Stat Cards -->
                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <!-- Card 1: Total Classes -->
                                <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="📚 총 학급수" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtTotalClassCount" Text="48 학급" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtSpecialClassCount" Text="일반 46 + 특수 2" FontSize="11" Foreground="{DynamicResource BeigeTextSub}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Estimated Students -->
                                <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="👥 예상 학생 정원" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtEstimatedStudents" Text="1,008 ~ 1,200명" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,4,0,0"/>
                                        <TextBlock Text="학급당 평균 21~25명 기준" FontSize="11" Foreground="{DynamicResource BeigeTextSub}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: School Foundation -->
                                <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🏛️ 설립 &amp; 개교기념일" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtFoundationDate" Text="1984. 05. 09" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtAnniversary" Text="개교기념일: 05월 09일" FontSize="11" Foreground="{DynamicResource BeigeTextSub}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Grade-by-Grade Class Breakdown -->
                            <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtBreakdownTitle" Text="📊 학년별 학급 편성 현황 (2025학년도)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}"/>
                                        <TextBlock Text="(단위: 학급)" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                                    </Grid>

                                    <!-- Grade Items List -->
                                    <ItemsControl x:Name="ListGradeClasses">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding GradeName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>

                                                    <!-- Visual Bar -->
                                                    <Border Grid.Column="1" Height="14" Background="#E7DAC7" CornerRadius="4" VerticalAlignment="Center" Margin="6,0,8,0">
                                                        <Border Background="{DynamicResource BeigeAccent}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidthPercent, ConverterParameter=2.0}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding ClassCount, StringFormat='{}{0} 학급'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Contact & Information Card -->
                            <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📍 학교 위치 및 연락망" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="도로명주소" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtRoadAddress" Grid.Column="1" Text="서울특별시 강남구 선릉로 363" FontSize="12" Foreground="{DynamicResource BeigeTextMain}"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="대표전화" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtTelNo" Grid.Column="1" Text="02-555-2455" FontSize="12" Foreground="{DynamicResource BeigeTextMain}"/>
                                        <TextBlock Grid.Column="2" Text="팩스번호" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtFaxNo" Grid.Column="3" Text="02-555-2485" FontSize="12" Foreground="{DynamicResource BeigeTextMain}"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="홈페이지" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}"/>
                                        <TextBlock x:Name="TxtHomePage" Grid.Column="1" Text="http://daechi.sen.es.kr/" FontSize="12" Foreground="{DynamicResource BeigeAccent}" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="TxtHomePage_MouseLeftButtonUp"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Bottom Action Toolbar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="⭐ 내 기본 학교로 설정" Click="BtnSetDefaultSchool_Click" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource BeigeAccentSoft}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeAccent}" BorderThickness="1" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="이 학교를 놀티쳐 기본 학교(급식/시간표)로 즉시 등록합니다.">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>

                                <Button Content="📊 학교알리미 공시 바로가기 ↗" Click="BtnOpenSchoolInfo_Click" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" ToolTip="학교알리미에서 상세 교원수, 학생수, 예결산 공시자료를 조회합니다.">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>

                                <Button Content="📋 학교 정보 복사" Click="BtnCopyInfo_Click" Padding="12,8" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                            </ScrollViewer>

                            <!-- Map View -->
                            <Border x:Name="PanelMapView" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" ClipToBounds="True">
                                <wv2:WebView2 x:Name="MapWebView" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
