<Window x:Class="KnolTeacher.Desktop.Views.Windows.NoticeZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공지 크게 보기"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#D90F172A"
        WindowState="Maximized"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="40">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="1200" MinWidth="700"
                Background="#1E293B"
                BorderBrush="#38BDF8" BorderThickness="2"
                CornerRadius="20" Padding="36"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="50" ShadowDepth="10" Opacity="0.7"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Badge -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#0284C7" CornerRadius="12" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📢" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="교실 전체 알림 (크게 보기)" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Main Large Text -->
                <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtLargeNotice"
                               Text="여기에 알림장 내용이 표시됩니다."
                               Foreground="#F8FAFC"
                               FontSize="48"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="68"
                               Margin="20,10"/>
                </ScrollViewer>

                <!-- Actions Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Button x:Name="BtnTts" Click="BtnTts_Click"
                            Background="#0369A1" Foreground="White"
                            Padding="20,12" Margin="0,0,16,0"
                            FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTtsLabel" Text="음성으로 읽기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Content="✕ 닫기 (ESC)" Click="BtnClose_Click"
                            Background="#334155" Foreground="#E2E8F0"
                            Padding="24,12"
                            FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
