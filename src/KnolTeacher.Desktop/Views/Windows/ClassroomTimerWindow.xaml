<Window x:Class="KnolTeacher.Desktop.Views.Windows.ClassroomTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⏱️ 교실 집중 타이머 (Alt+3)" Height="420" Width="520"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Timer Display (Responsive Viewbox) -->
            <RowDefinition Height="*" />
            <!-- Manual Input & Fine-Tuning -->
            <RowDefinition Height="Auto" />
            <!-- Quick Presets -->
            <RowDefinition Height="Auto" />
            <!-- Controls -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="⏱️ 교실 집중 타이머" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="BtnSwitchMonitor" Content="📺 모니터 2" Click="BtnSwitchMonitor_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="타이머를 모니터 1 ↔ 모니터 2로 즉시 이동"/>
        </Grid>

        <!-- Main Digits (Viewbox Auto-Scaling) -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,0,10" Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.3" ShadowDepth="4" Color="#000000"/>
            </Border.Effect>
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="TxtTime" Text="05:00" FontFamily="Consolas, Malgun Gothic" FontSize="64" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Viewbox>
        </Border>

        <!-- Manual Numeric Input & Fine Tuning -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="시간 직접입력:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TbMinutes" Text="05" Width="38" Height="28" FontSize="12" FontWeight="Bold" TextAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" KeyDown="TbTime_KeyDown"/>
                <TextBlock Text="분" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <TextBox x:Name="TbSeconds" Text="00" Width="38" Height="28" FontSize="12" FontWeight="Bold" TextAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" KeyDown="TbTime_KeyDown"/>
                <TextBlock Text="초" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button Content="설정" Click="BtnApplyManualTime_Click" Height="28" Padding="10,0" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+1분" Click="BtnAddSec_Click" Tag="60" Margin="2,0" Padding="8,4" Background="#334155" Foreground="#FDE047" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="+10초" Click="BtnAddSec_Click" Tag="10" Margin="2,0" Padding="8,4" Background="#334155" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="-10초" Click="BtnAddSec_Click" Tag="-10" Margin="2,0" Padding="8,4" Background="#334155" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Presets -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Content="1분" Click="BtnPreset_Click" Tag="1" Margin="0,0,6,0" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="3분" Click="BtnPreset_Click" Tag="3" Margin="0,0,6,0" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="5분" Click="BtnPreset_Click" Tag="5" Margin="0,0,6,0" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="10분" Click="BtnPreset_Click" Tag="10" Margin="0,0,6,0" Padding="12,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="40분" Click="BtnPreset_Click" Tag="40" Margin="0,0,6,0" Padding="12,6" Background="#475569" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnStartPause" Grid.Column="0" Content="▶ 시작" Click="BtnStartPause_Click" Margin="0,0,6,0" Padding="0,10" Background="#0284C7" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
            <Button x:Name="BtnReset" Grid.Column="1" Content="↺ 초기화" Click="BtnReset_Click" Margin="6,0,0,0" Padding="0,10" Background="#334155" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
