                                                <Grid>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="F2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <TextBlock Text="📋" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                        <TextBlock Text="놀보드 (학생 화면)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="모니터 2 전용 수업 대시보드 &amp; 알림판" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Tool 4: Class Timer [Alt+3] -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchTimer_Click">
                                                <Grid>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Alt+3" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <TextBlock Text="⏱️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                        <TextBlock Text="교실 집중 타이머" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="카운트다운 &amp; 모둠 활동 차임벨" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
