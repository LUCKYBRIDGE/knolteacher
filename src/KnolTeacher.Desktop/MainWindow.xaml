                                    <!-- 위젯 카드 7 (선택): 학급 공지 배너 -->
                                    <controls:MainWidgetCard x:Name="CardNotice" WidgetId="notice" Title="학급 공지 배너" Icon="📢" MinWidth="360" MinHeight="200" Visibility="Collapsed">
                                        <Grid Margin="12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
