                    </TabItem>
<!-- TAB 1: 수업 & 교실 도구 (Classroom Tools - 1-Click Access) -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,16">
                            <StackPanel Margin="0,4,0,0">
                                <!-- Section 1: 🎯 수업 실시간 도구 (Live Classroom) -->
