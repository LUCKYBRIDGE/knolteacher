                                            <!-- Calorie & Origin -->
                                            <Border Grid.Row="2" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,6,0,0">
                                                <TextBlock x:Name="TxtMealCalorie" Text="열량: 계산 중" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeLunchText}" HorizontalAlignment="Right"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 1: 수업 진행 도구 (Classroom Tools) -->
