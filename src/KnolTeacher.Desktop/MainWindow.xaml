                                </StackPanel>
                            </Border>

                            <!-- Tool 12: Workday & Allowance Calculator -->
                            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Cursor="Hand" MouseLeftButtonUp="BtnLaunchWorkdayCalculator_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🧮" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="월 15일 복무 계산기" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
