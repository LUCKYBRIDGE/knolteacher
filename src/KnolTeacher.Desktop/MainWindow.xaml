                                            </Button>
                                        </Grid>
                                    </controls:MainWidgetCard>

                                    <!-- 위젯 카드 9 (선택): 오늘의 날씨 & 미세먼지 -->
                                    <controls:MainWidgetCard x:Name="CardWeather" WidgetId="weather" Title="오늘의 날씨 &amp; 미세먼지" Icon="☀️" MinWidth="300" MinHeight="220" Visibility="Collapsed">
