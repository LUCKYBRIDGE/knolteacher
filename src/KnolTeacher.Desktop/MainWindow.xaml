                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏰" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="수업 예비령 타이머" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="교시 시작 전 대형 카운트다운" FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
