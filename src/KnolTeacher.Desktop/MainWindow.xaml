                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: 🏫 학급 경영 & 생활지도 (Classroom Management) -->
                                <Border Margin="0,0,0,16">
