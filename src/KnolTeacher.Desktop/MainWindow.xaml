                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Alt+8" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <TextBlock Text="🎰" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
