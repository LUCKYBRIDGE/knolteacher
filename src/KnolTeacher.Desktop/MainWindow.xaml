                                </StackPanel>
                            </Border>

                            <!-- Tool 13: Smart Seat Shuffle -->
                            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Cursor="Hand" MouseLeftButtonUp="BtnLaunchSeatShuffle_Click">
