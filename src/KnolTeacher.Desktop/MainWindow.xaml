<ui:FluentWindow x:Class="KnolTeacher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KnolTeacher.Desktop.ViewModels"
        xmlns:controls="clr-namespace:KnolTeacher.Desktop.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="메인화면"
        Icon="/assets/app_icon.ico"
        Height="960" Width="1680"
        MinHeight="800" MinWidth="1280"
        Background="{DynamicResource BeigeAppBg}"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!-- Segmented Tab RadioButton Style -->
        <Style x:Key="SegmentTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BeigeTextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" Opacity="0.12" ShadowDepth="1" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource BeigeAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MainWidgetCard Default Style -->
        <Style TargetType="{x:Type controls:MainWidgetCard}">
            <Setter Property="Background" Value="{DynamicResource BeigeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BeigeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MainWidgetCard}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.06" ShadowDepth="2" Color="#3E3835"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" x:Name="PART_HeaderBar"
                                        Background="{DynamicResource BeigeCardInner}"
                                        CornerRadius="13,13,0,0"
                                        BorderBrush="{DynamicResource BeigeCardBorder}"
                                        BorderThickness="0,0,0,1"
                                        Cursor="SizeAll">
                                    <Grid Margin="12,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Drag Grip & Icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="PART_LockIcon" Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="위젯 위치·크기 고정됨"/>
                                            <TextBlock x:Name="PART_DragGrip" Text="⋮⋮" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{TemplateBinding Icon}" FontSize="13.5" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="{DynamicResource BeigeTextMain}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="CharacterEllipsis"/>

                                        <!-- Right Controls: Size Toggle & Close -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PART_BtnToggleSize" Width="24" Height="24" Padding="0" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="위젯 크기 전환 (보통 / 확대)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bSize" CornerRadius="6" Background="Transparent">
                                                            <TextBlock Text="⤢" Foreground="{DynamicResource BeigeTextSub}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bSize" Property="Background" Value="{DynamicResource BeigeAccentSoft}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource BeigeAccent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="PART_BtnClose" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="이 위젯 숨기기 (우측 상단 '위젯 설정'에서 다시 열 수 있습니다)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bClose" CornerRadius="6" Background="Transparent">
                                                            <TextBlock Text="✕" Foreground="{DynamicResource BeigeTextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bClose" Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Content Body Area with Dedicated Bottom-Right Resize Grip -->
                                <Grid Grid.Row="1">
                                    <ContentPresenter Margin="0,0,0,6"/>

                                    <Thumb x:Name="PART_ResizeThumb"
                                           Width="16" Height="16"
                                           Cursor="SizeNWSE"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,3,3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" ToolTip="드래그하여 크기 조절">
                                                    <Path Data="M 12,4 L 12,12 L 4,12 Z M 7,9 L 12,4 M 3,12 L 12,3"
                                                          Stroke="{DynamicResource BeigeTextMuted}"
                                                          StrokeThickness="1.2"
                                                          Opacity="0.4"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Bottom"
                                                          Margin="2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <!-- Native Fluent TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Footer & Copyright -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="메인화면">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnLaunchSchoolScale_Click" ToolTip="클릭하여 내 기본 학교 변경 및 전국 학교 규모 통계 조회">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SchoolName}" FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GradeClassInfo}" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnUpdate_Click" ToolTip="최신 버전 확인 및 사이트 이동 없는 원클릭 자동 업데이트">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 v3.0.2" FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text=" (버전확인)" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnOpenStorageSettings_Click" ToolTip="판서 및 내보내기 파일 기본 저장 폴더 설정">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="저장폴더" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ======================================================== -->
        <!-- 💎 Main Body: Seamless Full-Width Top Header + Bento Grid -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Full-Width Clean Studio Top Header Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Workspace Grid (Bento Grid on Tab 0, Other Tools on Tabs 1-5) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Full-Width Top Header Bar -->
            <Border Grid.Row="0" Margin="18,10,18,10" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: KnolTeacher Brand + Live Period Capsule -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center: Floating White Action Pill Dock -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Utility Icons & Menu Drawer -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand + Live Capsule -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonUp="BtnReturnDashboard_Click" ToolTip="메인 대시보드로 이동">
                            <Image Source="/assets/app_icon_mono.png" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="KnolTeacher" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Malgun Gothic, Segoe UI"/>
                        </StackPanel>

                        <!-- 🔴 Live Period Status Capsule (Refined Calm Slate Signature) -->
                        <Border x:Name="PillLivePeriodStatus"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="11,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotLiveStatus" Width="7.5" Height="7.5" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLivePeriodStatus" Text="확인 중..." FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 🖥️ Dual Monitor Detection Status Capsule -->
                        <Border x:Name="PillMonitorStatus"
                                Background="#F1F5F9"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,5"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonUp="PillMonitorStatus_MouseLeftButtonUp"
                                ToolTip="디스플레이 연결 상태 (클릭하여 모니터 정보 및 기본 전송 설정 확인)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMonitorIcon" Text="📺" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtMonitorStatus" Text="모니터 감지 중..." FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCheckVersion" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Center: Floating White Action Pill Dock (Mockup Signature) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="{DynamicResource BeigeCardBorder}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="10,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Opacity="0.06" ShadowDepth="2" Color="#64748B"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 놀보드 F2 -->
                            <Button Click="BtnLaunchBoard_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Padding="10,5" Cursor="Hand" ToolTip="학생용 화면(모니터 2) 놀보드 열기 (F2)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📺" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="놀보드" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="{DynamicResource BeigeCardBorder}" Margin="4,0" VerticalAlignment="Center"/>

                            <!-- 화면판서 Alt+2 -->
                            <Button Click="BtnLaunchDrawing_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Padding="10,5" Cursor="Hand" ToolTip="현재 화면 일시정지 및 화면 위 주석 판서 (Alt+2)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖼️" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="화면판서" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="{DynamicResource BeigeCardBorder}" Margin="4,0" VerticalAlignment="Center"/>

                            <!-- 칠판보드 Alt+4 -->
                            <Button Click="BtnLaunchBoardDrawing_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Padding="10,5" Cursor="Hand" ToolTip="깨끗한 수업 전자칠판 보드판 열기 (Alt+4)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🟩" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="칠판보드" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+4" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="{DynamicResource BeigeCardBorder}" Margin="4,0" VerticalAlignment="Center"/>

                            <!-- 타이머 Alt+3 -->
                            <Button Click="BtnLaunchTimer_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Padding="10,5" Cursor="Hand" ToolTip="교실 집중 타이머 &amp; 차임벨 (Alt+3)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="타이머" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+3" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="14" Background="{DynamicResource BeigeCardBorder}" Margin="4,0" VerticalAlignment="Center"/>

                            <!-- 추첨 Alt+8 -->
                            <Button Click="BtnLaunchPicker_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Padding="10,5" Cursor="Hand" ToolTip="동물 아바타 발표자 추첨 레이스 (Alt+8)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎲" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="추첨" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+8" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextSub}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Utility Icons & Menu Drawer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Return Button for Tabs 1-5 -->
                        <Button x:Name="BtnReturnDashboard" Click="BtnReturnDashboard_Click" Visibility="Collapsed" Background="{DynamicResource BeigeAccentSoft}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" ToolTip="메인 일과 &amp; 급식 대시보드로 돌아가기">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="◀ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="대시보드 복귀" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Template Share -->
                        <Button x:Name="BtnOpenTemplateShare" Click="BtnLaunchTemplateShare_Click" Width="34" Height="34" Padding="0" Margin="0,0,5,0" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand" ToolTip="학생 명렬, 학사일정 양식 다운로드 및 동료 교사 설정 공유">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Tutorial / Help -->
                        <Button x:Name="BtnOpenTutorial" Click="BtnOpenTutorial_Click" Width="34" Height="34" Padding="0" Margin="0,0,5,0" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand" ToolTip="놀티쳐 주요 기능 둘러보기 및 초기 설정 도우미">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <TextBlock Text="❓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Alarm Bell (Auto-Width Pill, Prevents Text Clipping) -->
                        <Button x:Name="BtnTogglePeriodAlarm" Click="BtnTogglePeriodAlarm_Click" Height="34" Padding="10,0" Margin="0,0,6,0" Background="White" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand" ToolTip="수업 시작 예비령 및 교시 알람 토글">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPeriodAlarmIcon" Text="🔔" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPeriodAlarmLabel" Text="알람 ON" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Widget Customization Mode Switcher (Tab 0) -->
                        <Button x:Name="BtnToggleWidgetEdit" Click="BtnToggleWidgetEdit_Click" Height="34" Padding="11,0" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand" ToolTip="메인화면 위젯 커스텀 (배치, 크기조절, 추가, 숨김)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtWidgetEditIcon" Text="⚙️" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtWidgetEditLabel" Text="위젯 편집" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- All Tools Menu Drawer Toggle Button -->
                        <Button x:Name="BtnToggleDrawer" Click="BtnToggleDrawer_Click" Height="34" Padding="12,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="전체 교실 도구 및 다른 화면(수업도구, 예약, PC정리, 사이트, 나이스) 이동">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="☰" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="전체 메뉴" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Workspace: TabControl with Tab 0 Bento Grid and Tabs 1-5 -->
            <Grid Grid.Row="1">
                <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                    </TabControl.ItemContainerStyle>

                    <!-- TAB 0: 오늘의 일과 & 대시보드 위젯 캔버스 -->
                    <TabItem>
                        <Grid Margin="16,0,16,12">
                            <Grid.RowDefinitions>
                                <!-- Row 0: 위젯 편집 모드 액션바 (기본 숨김) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: 위젯 캔버스 뷰포트 -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1. 위젯 편집 모드 툴바 -->
                            <Border x:Name="BarWidgetEditTools" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10"
                                    Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="12" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🛠️ 위젯 편집 모드" FontSize="12.5" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="위젯 상단을 드래그하여 이동하고, 우측 하단 핸들로 크기를 조절하세요. [✕]로 숨길 수 있습니다." FontSize="11.5" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 위젯 추가 메뉴 버튼 -->
                                        <Button x:Name="BtnAddWidgetMenu" Click="BtnAddWidgetMenu_Click" Height="28" Padding="10,0" Margin="0,0,6,0" Background="White" Foreground="#1E40AF" BorderBrush="#93C5FD" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="위젯 추가 또는 숨겨진 위젯 다시 표시">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="➕ 위젯 추가 ▾" VerticalAlignment="Center"/>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="MenuAddWidgets">
                                                    <MenuItem Header="📅 오늘의 시간표" Click="MenuItemAddWidget_Click" Tag="timetable"/>
                                                    <MenuItem Header="📝 교사 할 일 &amp; 학생 알림장" Click="MenuItemAddWidget_Click" Tag="todo"/>
                                                    <MenuItem Header="🗓️ 학사일정 &amp; 월간 달력" Click="MenuItemAddWidget_Click" Tag="calendar"/>
                                                    <MenuItem Header="🍱 학교 점심 &amp; 날씨" Click="MenuItemAddWidget_Click" Tag="meal"/>
                                                    <Separator/>
                                                    <MenuItem Header="⏱️ 교실 집중 타이머" Click="MenuItemAddWidget_Click" Tag="timer"/>
                                                    <MenuItem Header="🎲 발표자 뽑기" Click="MenuItemAddWidget_Click" Tag="picker"/>
                                                    <MenuItem Header="📢 학급 공지 배너" Click="MenuItemAddWidget_Click" Tag="notice"/>
                                                    <MenuItem Header="🎯 D-Day 카운트다운" Click="MenuItemAddWidget_Click" Tag="dday"/>
                                                    <MenuItem Header="☀️ 오늘의 날씨 &amp; 미세먼지" Click="MenuItemAddWidget_Click" Tag="weather"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <!-- 기본배치 초기화 -->
                                        <Button Click="BtnResetWidgetLayout_Click" Height="28" Padding="10,0" Margin="0,0,6,0" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="기본 3열 표준 반응형 배치로 초기화">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="🔄 기본배치 초기화" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- 위치 잠금 토글 -->
                                        <Button x:Name="BtnToggleWidgetLock" Click="BtnToggleWidgetLock_Click" Height="28" Padding="10,0" Margin="0,0,8,0" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="위젯 위치 및 크기 고정 잠금/해제">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtWidgetLockIcon" Text="🔓" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtWidgetLockLabel" Text="위치 잠금" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 편집 완료 -->
                                        <Button Click="BtnFinishWidgetEdit_Click" Height="28" Padding="12,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="위젯 편집 완료 및 현재 배치 저장">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <TextBlock Text="💾 편집 완료" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. 위젯 캔버스 뷰포트 (스크롤뷰어 + 반응형 캔버스) -->
                            <ScrollViewer Grid.Row="1" x:Name="MainWidgetScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          SizeChanged="MainWidgetScrollViewer_SizeChanged">
                                <Canvas x:Name="MainWidgetCanvas"
                                        Width="1460" Height="860"
                                        Background="Transparent">
                                    <!-- 위젯 카드 1: 오늘의 시간표 -->
                                    <controls:MainWidgetCard x:Name="CardTimetable" WidgetId="timetable" Title="오늘의 시간표" Icon="📅" MinWidth="300" MinHeight="260">
                                        <Grid Margin="14,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="🔔 예비 타이머 설정" Click="BtnOpenPeriodAlarmSettings_Click" Height="26" Padding="8,0" Margin="0,0,6,0" Background="{DynamicResource BeigeAccentSoft}" Foreground="{DynamicResource BeigeAccent}" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="수업 시작 전 예비령 &amp; 대형 카운트다운 타이머 전체 설정">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="···" Click="BtnTimetableMore_Click" Width="26" Height="22" Background="Transparent" Foreground="{DynamicResource BeigeTextMuted}" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" ToolTip="시간표 설정 및 과목 편집">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="✏️ 시간표 과목 직접 수정..." Click="BtnEditAllTimetable_Click"/>
                                                            <MenuItem Header="🔔 수업 시작 예비령/알람 설정" Click="BtnOpenPeriodAlarmSettings_Click"/>
                                                            <MenuItem Header="📁 파일 기본 저장 폴더 설정" Click="BtnOpenStorageSettings_Click"/>
                                                            <MenuItem Header="🔄 시간표 일괄 당기기/미루기" Click="BtnShiftTimetable_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="⏱️ 40분 수업 타이머 즉시 실행" Click="BtnLaunchClassTimer_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="오늘의 시간표" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Timetable List -->
                                        <ListBox x:Name="ListTimetable" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,7" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="10,8" Cursor="Hand" ToolTip="우클릭하여 과목명/태그/타이머를 빠르게 수정할 수 있습니다 (더블클릭 시 바로 수정)">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BeigeCardBorder}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                        <Setter Property="Background" Value="#F0F7FF"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BeigeAccent}"/>
                                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="✏️ 과목명 직접 수정..." Click="MenuEditSubject_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="📚 빠른 과목 변경">
                                                                    <MenuItem Header="국어" Click="MenuQuickSubject_Click" Tag="국어"/>
                                                                    <MenuItem Header="수학" Click="MenuQuickSubject_Click" Tag="수학"/>
                                                                    <MenuItem Header="사회" Click="MenuQuickSubject_Click" Tag="사회"/>
                                                                    <MenuItem Header="과학" Click="MenuQuickSubject_Click" Tag="과학"/>
                                                                    <MenuItem Header="영어" Click="MenuQuickSubject_Click" Tag="영어"/>
                                                                    <MenuItem Header="체육" Click="MenuQuickSubject_Click" Tag="체육"/>
                                                                    <MenuItem Header="음악" Click="MenuQuickSubject_Click" Tag="음악"/>
                                                                    <MenuItem Header="미술" Click="MenuQuickSubject_Click" Tag="미술"/>
                                                                    <MenuItem Header="도덕" Click="MenuQuickSubject_Click" Tag="도덕"/>
                                                                    <MenuItem Header="실과" Click="MenuQuickSubject_Click" Tag="실과"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="창체 (창의적 체험활동)" Click="MenuQuickSubject_Click" Tag="창체"/>
                                                                    <MenuItem Header="동아리" Click="MenuQuickSubject_Click" Tag="동아리"/>
                                                                    <MenuItem Header="자율 / 안전" Click="MenuQuickSubject_Click" Tag="자율"/>
                                                                    <MenuItem Header="진로활동" Click="MenuQuickSubject_Click" Tag="진로"/>
                                                                </MenuItem>
                                                                <MenuItem Header="🏷️ 수업 구분(태그) 설정">
                                                                    <MenuItem Header="🏫 교실 수업" Click="MenuQuickTag_Click" Tag="교실수업"/>
                                                                    <MenuItem Header="🎒 이동 수업" Click="MenuQuickTag_Click" Tag="이동수업"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="태그 없음" Click="MenuQuickTag_Click" Tag=""/>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="⏱️ 이 교시 시작 전 예비 타이머 설정..." Click="MenuItemPeriodTimerSettings_Click"/>
                                                                <MenuItem Header="⏱️ 이 교시 40분 타이머 바로 실행" Click="MenuItemTimer_Click"/>
                                                                <MenuItem Header="🔔 이 교시 예비 알람 토글 (ON/OFF)" Click="MenuItemToggleAlarm_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="🏫 교실수업 알람으로 설정 (기본 5분 전)" Click="MenuQuickPeriodTravel_Click" Tag="classroom"/>
                                                                <MenuItem Header="🎒 이동수업 알람으로 설정 (기본 10분 전)" Click="MenuQuickPeriodTravel_Click" Tag="travel"/>
                                                                <MenuItem Header="🔕 이 교시 알람 삭제(끄기)" Click="MenuQuickPeriodDisable_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="🧹 빈 시간으로 비우기" Click="MenuClearSubject_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Period Badge -->
                                                            <Border Grid.Column="0" CornerRadius="7" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource BeigeAccent}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DisplayBadge}" FontSize="11" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Subject + Time Range -->
                                                            <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRange, StringFormat='({0})'}" FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Text="{Binding Subject}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BeigeTextMain}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>

                                                            <!-- Quick action icon (timer / edit / alarm badge) -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Click="BtnItemTimer_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="7,2" Background="{Binding AlarmBadgeBg}" Foreground="{Binding AlarmBadgeFg}" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" Visibility="{Binding AlarmBadgeVisibility}" ToolTip="이 교시 시작 전 알람 설정 (교실수업/이동수업/직접수정/삭제)">
                                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                                    <TextBlock Text="{Binding AlarmBadgeText}"/>
                                                                </Button>
                                                                <Button Content="⏱️" Click="BtnItemTimer_Click" Tag="{Binding}" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="이 교시 시작 전 타이머 &amp; 예비 알람 상세 설정"/>
                                                                <Button Content="✏️" Click="BtnEditSubject_Click" Tag="{Binding}" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="과목 수정"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    </controls:MainWidgetCard>

                                    <!-- 위젯 카드 2: 교사 할 일 & 학생 알림장 -->
                                    <controls:MainWidgetCard x:Name="CardTodo" WidgetId="todo" Title="교사 할 일 &amp; 학생 알림장" Icon="📝" MinWidth="300" MinHeight="220">
                                        <Grid Margin="14,10">
                                        <Grid.RowDefinitions>
                                            <!-- 0: Header with Segmented Switcher -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 1: Active Workspace Panel -->
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Segmented Switcher & Options -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="···" Click="BtnTodoMore_Click" Width="26" Height="22" Background="Transparent" Foreground="{DynamicResource BeigeTextMuted}" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" ToolTip="할 일 및 알림장 옵션">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="🧹 완료된 할 일 모두 정리" Click="MenuClearCompletedTodos_Click"/>
                                                        <MenuItem Header="🔄 기본 교실 체크리스트 불러오기" Click="MenuResetSampleTodos_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="📺 학생 화면(모니터 2) 놀보드 알림장 열기 (F2)" Click="BtnLaunchBoard_Click"/>
                                                        <MenuItem Header="🔍 알림장 크게 보기 (확대 창)" Click="BtnZoomNoticeFromMain_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>

                                            <!-- Segmented Pill Switcher -->
                                            <Border Background="#F1F5F9" CornerRadius="10" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbTabTeacherTodo" Content="🔒 선생님 할 일" IsChecked="True" Checked="RbMemoTab_Checked"
                                                                 Style="{StaticResource SegmentTabRadioStyle}"/>
                                                    <RadioButton x:Name="RbTabStudentNotice" Content="📢 학급 알림장" Checked="RbMemoTab_Checked"
                                                                 Style="{StaticResource SegmentTabRadioStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DockPanel>

                                        <!-- 1-A: Teacher Todo Panel (교사 비공개 업무/체크리스트) -->
                                        <Grid x:Name="PanelTeacherTodo" Grid.Row="1" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Todo List -->
                                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                                <ItemsControl x:Name="ListTodoItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsCompleted}" Click="TodoCheckbox_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BeigeTextMuted}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Button Grid.Column="2" Content="✕" Click="BtnDeleteTodo_Click" Tag="{Binding}" Width="18" Height="18" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="9" Cursor="Hand" ToolTip="삭제"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Quick Add Box -->
                                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TbNewTodo" BorderThickness="0" Background="Transparent" FontSize="11.5" Foreground="{DynamicResource BeigeTextMain}" Padding="4,4" VerticalAlignment="Center" KeyDown="TbNewTodo_KeyDown" />
                                                    <Button Grid.Column="1" Content="추가" Click="BtnAddTodo_Click" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Padding="8,4" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- 1-B: Student Notice Panel (학생 공개용 / 모니터 2 실시간 전송) -->
                                        <Grid x:Name="PanelStudentNotice" Grid.Row="1" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <!-- Quick Tags & Tools -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Notice Text Editor -->
                                                <RowDefinition Height="*"/>
                                                <!-- Monitor 2 Send Action Bar -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top Quick Tags & Buttons -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🔍 크게보기" Click="BtnZoomNoticeFromMain_Click" ToolTip="알림장 전체화면 확대" Height="22" Padding="6,0" Margin="0,0,4,0" Background="#EFF6FF" Foreground="{DynamicResource BeigeAccent}" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="BtnTtsNoticeMain" Content="🔊 낭독" Click="BtnTtsNoticeMain_Click" ToolTip="알림장 한국어 음성 낭독" Height="22" Padding="6,0" Background="#F0FDF4" Foreground="#166534" BorderBrush="#BBF7D0" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="+알림" Click="BtnInsertNoticeTag_Click" Tag="• [알림] " Height="22" Padding="5,0" Margin="0,0,3,0" Background="#F1F5F9" Foreground="#0284C7" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Content="+준비물" Click="BtnInsertNoticeTag_Click" Tag="• [준비물] " Height="22" Padding="5,0" Margin="0,0,3,0" Background="#F1F5F9" Foreground="#D97706" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Content="+과제" Click="BtnInsertNoticeTag_Click" Tag="• [과제] " Height="22" Padding="5,0" Margin="0,0,3,0" Background="#F1F5F9" Foreground="#DB2777" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Notice Text Area -->
                                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="6">
                                                <TextBox x:Name="TbMainNotice" AcceptsReturn="True" TextWrapping="Wrap"
                                                         BorderThickness="0" Background="Transparent"
                                                         FontSize="12.5" Foreground="{DynamicResource BeigeTextMain}"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextChanged="TbMainNotice_TextChanged"/>
                                            </Border>

                                            <!-- Bottom Monitor Action Bar -->
                                            <Border Grid.Row="2" Margin="0,6,0,0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📺" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="모니터 2(놀보드 알림장) 실시간 동기화" FontSize="10.5" Foreground="#0369A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="학생 화면 띄우기" Click="BtnSendNoticeToMonitor2_Click"
                                                            Padding="8,3" Background="#0284C7" Foreground="White" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    </controls:MainWidgetCard>

                                    <!-- 위젯 카드 3: 학사일정 & 월간 달력 -->
                                    <controls:MainWidgetCard x:Name="CardCalendar" WidgetId="calendar" Title="학사일정 &amp; 월간 달력" Icon="🗓️" MinWidth="380" MinHeight="420">
                                        <Grid Margin="12,10">
                                            <Grid.RowDefinitions>
                                                <!-- 0: Month Navigation Header -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- 1: Weekday Headers -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- 2: 7x6 Calendar Grid -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- 3: Tab Selector / Section Divider -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- 4: Schedule &amp; Memo Content List -->
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 0: Header -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnCalPrev" Click="BtnCalPrev_Click" Content="‹" Width="24" Height="24" Padding="0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="14" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <TextBlock x:Name="TxtCalMonthYear" Text="2026년 9월" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeAccent}" VerticalAlignment="Center" Margin="8,0"/>
                                                    <Button x:Name="BtnCalNext" Click="BtnCalNext_Click" Content="›" Width="24" Height="24" Padding="0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="14" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="BtnCalToday" Click="BtnCalToday_Click" Content="오늘" Padding="6,2" Margin="6,0,0,0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10.5" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="BtnAddCalendarEvent" Click="BtnAddCalendarEvent_Click" Content="➕ 일정 등록" Padding="8,2" Margin="8,0,0,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="새 일정 또는 메모를 등록합니다.">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="월간 일정 &amp; 메모" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- 1: Weekday Names -->
                                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                                                <TextBlock Text="일" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="월" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="화" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="수" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="목" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="금" Foreground="{DynamicResource BeigeTextMuted}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="토" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </UniformGrid>

                                            <!-- 2: Calendar Day Cells (Today is Blue Circle, dots for events) -->
                                            <ItemsControl x:Name="ListCalendarCells" Grid.Row="2" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="1" CornerRadius="8" Padding="1,2" Cursor="Hand" MouseLeftButtonUp="CalDay_MouseLeftButtonUp" Tag="{Binding}" MinHeight="32">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                                            <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <!-- Circular badge for today -->
                                                                <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource BeigeAccent}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{Binding DayForeground}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                            <Setter Property="Foreground" Value="White"/>
                                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Dual Dots: School event dot + Teacher custom event dot -->
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,21,0,0">
                                                                    <Ellipse Width="4" Height="4" Margin="1,0" Fill="{Binding DotColor}" Visibility="{Binding DotVisibility}"/>
                                                                    <Ellipse Width="4" Height="4" Margin="1,0" Fill="{Binding TeacherDotColor}" Visibility="{Binding TeacherDotVisibility}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 3: Tab Selector / Section Divider -->
                                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="4,6" Margin="0,2,0,8">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="BtnAddEventForSelectedDay" Click="BtnAddCalendarEvent_Click" Content="➕ 일정 추가" Padding="6,2" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton x:Name="RbViewSelectedDay" Content="📅 선택일 일정·메모" IsChecked="True" Checked="RbViewMode_Checked" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,0,10,0" Cursor="Hand"/>
                                                        <RadioButton x:Name="RbViewMonthSchedule" Content="🏫 이번달 학사일정" Checked="RbViewMode_Checked" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMuted}" Cursor="Hand"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- 4: Schedule &amp; Memo Content List -->
                                            <Grid Grid.Row="4">
                                                <!-- 4-A: Selected Day Events &amp; Memos Panel -->
                                                <Grid x:Name="PanelSelectedDayView" Visibility="Visible">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Selected Date Header -->
                                                    <TextBlock x:Name="TxtSelectedDayTitle" Grid.Row="0" Text="9월 9일 (수)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" Margin="2,0,0,6"/>

                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel>
                                                            <!-- School Academic Events for Selected Day -->
                                                            <ItemsControl x:Name="ListSelectedDayAcademicEvents" Margin="0,0,0,6">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                                                            <DockPanel LastChildFill="True">
                                                                                <Border DockPanel.Dock="Left" Background="#F59E0B" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="🏫 학사" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding EventName}" FontSize="12" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Teacher Custom Events for Selected Day -->
                                                            <ItemsControl x:Name="ListSelectedDayTeacherEvents">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{Binding LightBackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Left Color Indicator Bar -->
                                                                                <Border Grid.RowSpan="2" Grid.Column="0" Width="4" Background="{Binding ColorBrush}" CornerRadius="2" Margin="0,0,8,0"/>

                                                                                <!-- Title and Badges -->
                                                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Border Background="White" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                                        <TextBlock Text="{Binding DisplayTimeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ColorBrush}"/>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Text="{Binding AlarmText}" FontSize="10" FontWeight="SemiBold" Foreground="#EA580C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <!-- Action Buttons: Edit &amp; Delete -->
                                                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Button Content="✏️" Click="BtnEditCalendarEvent_Click" Tag="{Binding}" Width="22" Height="22" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="수정"/>
                                                                                    <Button Content="🗑️" Click="BtnDeleteCalendarEvent_Click" Tag="{Binding}" Width="22" Height="22" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="삭제"/>
                                                                                </StackPanel>

                                                                                <!-- Memo content if present -->
                                                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Memo}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Empty State Panel -->
                                                            <Border x:Name="PanelNoEventsForDay" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,16" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="📝" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="선택한 날짜에 등록된 일정이나 메모가 없습니다." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                                    <Button Click="BtnAddCalendarEvent_Click" Content="➕ 이 날짜에 일정·메모 추가" Padding="10,4" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Cursor="Hand">
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>

                                                <!-- 4-B: Month Academic Events Panel -->
                                                <Grid x:Name="PanelMonthScheduleView" Visibility="Collapsed">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl x:Name="ListMonthAcademicEvents">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="4,0,4,8" Cursor="Hand">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="38"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:d일}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BeigeTextSub}" VerticalAlignment="Center"/>
                                                                        <Border Grid.Column="1" Width="2" Height="14" Background="{DynamicResource BeigeAccent}" CornerRadius="1" Margin="6,0,10,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding EventName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>

                                            <!-- Hidden backward compatibility fields -->
                                            <TextBlock x:Name="TxtCalSelectedDate" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TxtCalSelectedEvent" Visibility="Collapsed"/>
                                            <ItemsControl x:Name="ListUpcomingDDays" Visibility="Collapsed"/>
                                            <TextBox x:Name="TxtClassNoticeMemo" Visibility="Collapsed"/>
                                        </Grid>
                                    </controls:MainWidgetCard>

                                    <!-- 위젯 카드 4: 학교 점심 & 날씨 -->
                                    <controls:MainWidgetCard x:Name="CardMeal" WidgetId="meal" Title="학교 점심 &amp; 날씨" Icon="🍱" MinWidth="320" MinHeight="420">
                                        <Grid Margin="14,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1.15*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="0.85*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Card 4-A: 학교 점심 -->
                                            <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtMealCaloriePill" Text="720 kcal" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                            </Border>
                                            <TextBlock Text="학교 점심" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Subtitle -->
                                        <TextBlock Grid.Row="1" Text="당일 메뉴" FontSize="11.5" Foreground="{DynamicResource BeigeTextMuted}" Margin="0,0,0,8"/>

                                        <!-- Menu Container Box -->
                                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="TxtMealMenu" Text="식단 불러오는 중..." FontSize="12.5" LineHeight="21" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Date navigation footer -->
                                        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnMealPrev" Click="BtnMealPrev_Click" Content="‹" Width="22" Height="20" Padding="0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="12" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <TextBlock x:Name="TxtMealDate" Text="오늘" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BeigeAccent}" VerticalAlignment="Center" Margin="6,0"/>
                                                <Button x:Name="BtnMealNext" Click="BtnMealNext_Click" Content="›" Width="22" Height="20" Padding="0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="12" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="BtnMealToday" Click="BtnMealToday_Click" Content="오늘" Padding="5,1" Margin="4,0,0,0" Background="#F8FAFC" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtMealCalorie" Visibility="Collapsed"/>
                                        </DockPanel>
                                    </Grid>

                                    <!-- Divider -->
                                            <Border Grid.Row="1" Height="1" Background="{DynamicResource BeigeCardBorder}" Margin="0,8,0,8"/>

                                            <!-- Card 4-B: 날씨 & 미세먼지 -->
                                            <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox x:Name="ComboWeatherRegion" Height="22" FontSize="10" SelectionChanged="ComboWeatherRegion_SelectionChanged" Padding="4,0" Margin="0,0,4,0"/>
                                                <Button Content="···" Click="BtnRefreshWeather_Click" Width="26" Height="22" Background="Transparent" Foreground="{DynamicResource BeigeTextMuted}" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" ToolTip="날씨 새로고침"/>
                                            </StackPanel>
                                            <TextBlock Text="날씨" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Hero Weather -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtWeatherIcon" Text="☀️" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtWeatherTemp" Text="18.5°C" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Details -->
                                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
