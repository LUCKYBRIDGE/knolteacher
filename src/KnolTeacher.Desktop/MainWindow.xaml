                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtMiniDDayCount" Text="D-14" FontSize="36" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center"/>
