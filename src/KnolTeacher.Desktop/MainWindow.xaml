<ui:FluentWindow x:Class="KnolTeacher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KnolTeacher.Desktop.ViewModels"
        xmlns:controls="clr-namespace:KnolTeacher.Desktop.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="놀티쳐 (KnolTeacher v3.0.0 - 스마트 교사용 올인원 도구)"
        Icon="/assets/app_icon.ico"
        Height="870" Width="1340"
        MinHeight="700" MinWidth="1050"
        Background="{DynamicResource BeigeAppBg}"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!-- MainWidgetCard Default Style -->
        <Style TargetType="{x:Type controls:MainWidgetCard}">
            <Setter Property="Background" Value="{DynamicResource BeigeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BeigeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MainWidgetCard}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.08" ShadowDepth="2" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" x:Name="PART_HeaderBar"
                                        Background="{DynamicResource BeigeCardInner}"
                                        CornerRadius="11,11,0,0"
                                        BorderBrush="{DynamicResource BeigeCardBorder}"
                                        BorderThickness="0,0,0,1"
                                        Cursor="SizeAll">
                                    <Grid Margin="12,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Drag Grip & Icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="PART_LockIcon" Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="위젯 위치·크기 고정됨"/>
                                            <TextBlock x:Name="PART_DragGrip" Text="⋮⋮" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{TemplateBinding Icon}" FontSize="13.5" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="{DynamicResource BeigeTextMain}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="CharacterEllipsis"/>

                                        <!-- Right Controls: Size Toggle & Close -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PART_BtnToggleSize" Width="24" Height="24" Padding="0" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="위젯 크기 전환 (보통 / 확대)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bSize" CornerRadius="6" Background="Transparent">
                                                            <TextBlock Text="⤢" Foreground="{DynamicResource BeigeTextSub}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bSize" Property="Background" Value="{DynamicResource BeigeAccentSoft}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource BeigeAccent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="PART_BtnClose" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="이 위젯 숨기기 (우측 상단 '위젯 설정'에서 다시 열 수 있습니다)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bClose" CornerRadius="6" Background="Transparent">
                                                            <TextBlock Text="✕" Foreground="{DynamicResource BeigeTextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bClose" Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Content Body Area with Dedicated Bottom-Right Resize Grip -->
                                <Grid Grid.Row="1">
                                    <ContentPresenter Margin="0,0,0,6"/>

                                    <Thumb x:Name="PART_ResizeThumb"
                                           Width="16" Height="16"
                                           Cursor="SizeNWSE"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,3,3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" ToolTip="드래그하여 크기 조절">
                                                    <Path Data="M 12,4 L 12,12 L 4,12 Z M 7,9 L 12,4 M 3,12 L 12,3"
                                                          Stroke="{DynamicResource BeigeTextMuted}"
                                                          StrokeThickness="1.2"
                                                          Opacity="0.4"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Bottom"
                                                          Margin="2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <!-- Native Fluent TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Footer & Copyright -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="놀티쳐 (KnolTeacher v3.0.0)">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="/assets/app_icon.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource BeigeAccentSoft}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnLaunchSchoolScale_Click" ToolTip="클릭하여 내 기본 학교 변경 및 전국 학교 규모 통계 조회">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SchoolName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BeigeAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GradeClassInfo}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextSub}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BtnUpdate_Click" ToolTip="최신 버전 확인 및 사이트 이동 없는 원클릭 자동 업데이트">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 v3.0.0" FontWeight="Bold" FontSize="11" Foreground="#B45309" VerticalAlignment="Center"/>
                            <TextBlock Text=" (버전확인)" FontSize="10" Foreground="#D97706" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar -->
                <ColumnDefinition Width="252" MinWidth="230" />
                <!-- Right Workspace Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Sidebar (Dynamic Theme) -->
            <Border Grid.Column="0" Background="{DynamicResource BeigeSidebarBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Brand Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Primary Signature Button -->
                        <RowDefinition Height="Auto" />
                        <!-- Menu Items -->
                        <RowDefinition Height="*" />
                        <!-- Sidebar Bottom Theme Switcher -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Margin="14,14,14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/assets/app_icon.png" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="놀티쳐" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="KnolTeacher • pinky-ne.com" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMuted}" Cursor="Hand" Margin="34,2,0,0" MouseLeftButtonUp="LogoSub_MouseLeftButtonUp" ToolTip="놀퀴즈 (pinky-ne.com) 플랫폼 바로가기"/>
                    </StackPanel>

                    <!-- 🌟 Primary Signature Button: 놀보드 열기 (F2) -->
                    <Border Grid.Row="1" Margin="12,4,12,10">
                        <Button x:Name="BtnSidebarBoard" Click="BtnLaunchBoard_Click"
                                Background="{DynamicResource BeigeAccent}"
                                Foreground="White"
                                Height="42"
                                FontWeight="Bold" FontSize="13"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Padding="12,0"
                                Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#92400E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="F2" FontSize="10" FontWeight="Bold" Foreground="#FEF3C7"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="놀보드 열기" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="메뉴" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMuted}" Margin="8,0,0,6"/>

                            <Button x:Name="NavBtnToday" Click="NavBtn_Click" Tag="0" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="일과 &amp; 급식" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnTools" Click="NavBtn_Click" Tag="1" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand" ToolTip="15개 수업·학급·행정 도구 모음 (1-Click)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧰" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="수업 &amp; 교실 도구" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnSchedule" Click="NavBtn_Click" Tag="2" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏰" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="예약 실행 &amp; 알림" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnZen" Click="NavBtn_Click" Tag="3" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧹" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="바탕화면 &amp; PC 정리" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnSites" Click="NavBtn_Click" Tag="4" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="유용한 교육 사이트" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnNeis" Click="NavBtn_Click" Tag="5" Background="Transparent" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" Height="36" HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,3" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="나이스 평어 일괄입력" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 🌟 Pinky-NE Classroom Banner -->
                            <Border Margin="0,4,0,4" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="BannerPinky_Click" ToolTip="핑키네(Pinky-NE) 교실자료실 &amp; 놀퀴즈 바로가기 (pinky-ne.com)">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌟" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="핑키네 (Pinky-NE)" FontWeight="Bold" FontSize="11" Foreground="#BE123C"/>
                                    </StackPanel>
                                    <TextBlock Text="초등 교실자료실 &amp; 놀퀴즈 ↗" FontSize="10" Foreground="#E11D48" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,8,0,8" Background="{DynamicResource BeigeCardBorder}"/>

                            <TextBlock Text="수업 필수 단축키 (0-Click)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMuted}" Margin="8,0,0,6"/>

                            <!-- Alt+2 Screen Drawing -->
                            <Button Click="BtnLaunchDrawing_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextSub}" Height="34" HorizontalContentAlignment="Stretch" Padding="8,0" Margin="0,0,0,2" BorderThickness="0" Cursor="Hand" ToolTip="수업 화면 정지 &amp; 판서 (Alt+2)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✏️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="화면 전체 판서" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Alt+3 Class Timer -->
                            <Button Click="BtnLaunchTimer_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextSub}" Height="34" HorizontalContentAlignment="Stretch" Padding="8,0" Margin="0,0,0,2" BorderThickness="0" Cursor="Hand" ToolTip="교실 집중 타이머 &amp; 차임벨 (Alt+3)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏱️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="교실 집중 타이머" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Alt+8 Pinball Picker -->
                            <Button Click="BtnLaunchPicker_Click" Background="Transparent" Foreground="{DynamicResource BeigeTextSub}" Height="34" HorizontalContentAlignment="Stretch" Padding="8,0" Margin="0,0,0,2" BorderThickness="0" Cursor="Hand" ToolTip="32종 동물 아바타 레이스 &amp; 발표자 추첨 (Alt+8)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+8" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎰" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="뽑기 레이스" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Dynamic Theme Switcher (Beige | Dark | Light) -->
                    <Border Grid.Row="3" Margin="10,4,10,12" Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="🎨 실시간 테마 선택" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMuted}" Margin="2,0,0,4"/>
                            <UniformGrid Columns="3">
                                <Button Content="🌾베이지" Click="BtnTheme_Click" Tag="Beige" FontSize="10" Padding="0,4" Margin="1" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="🌙다크" Click="BtnTheme_Click" Tag="Dark" FontSize="10" Padding="0,4" Margin="1" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="☀️라이트" Click="BtnTheme_Click" Tag="Light" FontSize="10" Padding="0,4" Margin="1" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderThickness="0" Cursor="Hand"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Right Workspace Content Area -->
            <Grid Grid.Column="1" Margin="16,10,16,6">
                <Grid.RowDefinitions>
                    <!-- Global Top Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Content Tabs -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Global Top Header Bar -->
                <Border Grid.Row="0" Margin="0,0,0,10" Padding="4,0,4,8" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock x:Name="TxtViewTitle" Text="📅 오늘의 일과 &amp; 급식" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCheckVersion" Visibility="Collapsed" />

                        <!-- Top Right Controls for Tab 0: Widget Layout & Sizing -->
                        <StackPanel x:Name="HeaderWidgetControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenTemplateShare"
                                    Click="BtnLaunchTemplateShare_Click"
                                    Background="{DynamicResource BeigeCardInner}"
                                    Foreground="{DynamicResource BeigeTextMain}"
                                    BorderBrush="{DynamicResource BeigeCardBorder}"
                                    BorderThickness="1"
                                    Padding="9,5"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    ToolTip="학생 명렬, 학사일정, 주간 시간표 양식 다운로드 및 동료 교사 설정 공유">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="양식·데이터 공유" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnOpenTutorial"
                                    Click="BtnOpenTutorial_Click"
                                    Background="{DynamicResource BeigeCardInner}"
                                    Foreground="{DynamicResource BeigeTextMain}"
                                    BorderBrush="{DynamicResource BeigeCardBorder}"
                                    BorderThickness="1"
                                    Padding="9,5"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    ToolTip="놀티쳐 주요 기능 둘러보기 및 초기 설정 도우미">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎓 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="튜토리얼" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToggleWidgetCustomize"
                                    Click="BtnToggleWidgetCustomize_Click"
                                    Background="{DynamicResource BeigeAccentSoft}"
                                    Foreground="{DynamicResource BeigeAccent}"
                                    BorderBrush="{DynamicResource BeigeCardBorder}"
                                    BorderThickness="1"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="메인화면 위젯 크기 조절, 자유 배치, 위젯 추가 및 제거">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📐 " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="위젯 크기·배치 설정" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Workspace Tab Pages -->
                <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="Transparent">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                    </TabControl.ItemContainerStyle>

                    <!-- TAB 0: 오늘의 일과 & 급식 (Today) -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: Collapsible Modern Widget Customization Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 1: Workspace Widget Canvas -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Modern Widget Customization & Sizing Bar (Collapsible) -->
                            <Border x:Name="WidgetCustomizeBar"
                                    Grid.Row="0"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource BeigeCardInner}"
                                    BorderBrush="{DynamicResource BeigeAccent}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,10"
                                    Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Opacity="0.08" ShadowDepth="2" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: 위젯 켜기/끄기 칩 목록 -->
                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                                        <TextBlock Text="🧩 위젯 켜기/끄기:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkWidgetNotice" Content="📢 학급 안내" IsChecked="True" Click="ChkWidget_Click" Tag="banner" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetClock" Content="⏰ 시계" IsChecked="True" Click="ChkWidget_Click" Tag="clock" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetTimetable" Content="🕒 시간표" IsChecked="True" Click="ChkWidget_Click" Tag="timetable" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetCalendar" Content="📅 학사일정" IsChecked="True" Click="ChkWidget_Click" Tag="calendar" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetDDay" Content="🚩 D-Day/메모" IsChecked="True" Click="ChkWidget_Click" Tag="dday" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetWeather" Content="⛅ 날씨" IsChecked="True" Click="ChkWidget_Click" Tag="weather" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                            <CheckBox x:Name="ChkWidgetMeal" Content="🍱 점심 식단" IsChecked="True" Click="ChkWidget_Click" Tag="meal" Margin="0,0,12,2" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BeigeTextMain}"/>
                                        </WrapPanel>
                                    </DockPanel>

                                    <!-- Row 1: 프리셋 버튼, 잠금 토글, 초기화, 저장 -->
                                    <DockPanel Grid.Row="1" LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📐 빠른 배치:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Click="BtnPresetDefault_Click" Content="🔲 기본 3단 분할" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Click="BtnPresetFocusTimetableMeal_Click" Content="🕒 시간표+급식 집중" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Click="BtnPresetFocusCalendar_Click" Content="📅 학사일정 집중" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Lock Toggle -->
                                            <Button x:Name="BtnToggleWidgetLock" Click="BtnToggleWidgetLock_Click" Content="🔓 위젯 조절 모드" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource BeigeAccentSoft}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="완성된 위젯의 크기 및 위치 고정 (수업 중 오작동 방지)">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <!-- Reset -->
                                            <Button Click="BtnResetWidgetLayout_Click" Content="🔄 초기화" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="11" Cursor="Hand" ToolTip="기본 위치와 크기로 원복">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <!-- Save -->
                                            <Button Click="BtnSaveWidgetLayout_Click" Content="💾 배치 저장" Padding="12,5" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="현재 배치 및 크기를 사용자 기본값으로 영구 저장">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Main Workspace Widget Host Canvas inside ScrollViewer -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="WidgetScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False">
                                <Canvas x:Name="MainWidgetCanvas"
                                        ClipToBounds="False"
                                        Background="Transparent"
                                        SizeChanged="MainWidgetCanvas_SizeChanged">

                                    <!-- Widget 1: 학급 안내 배너 (Anti-Clipping: TextWrapping, MinWidth 340, MinHeight 70) -->
                                    <controls:MainWidgetCard x:Name="WidgetNotice"
                                                             WidgetId="banner"
                                                             Title="오늘의 학급 안내 / 목표"
                                                             Icon="📢"
                                                             DefaultWidth="740"
                                                             DefaultHeight="74"
                                                             MinWidth="340"
                                                             MinHeight="70"
                                                             Canvas.Left="0"
                                                             Canvas.Top="0">
                                        <Border Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="📢" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="오늘의 학급 안내 / 목표" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                        <TextBlock Text=" • 실시간 전달사항" FontSize="10" Foreground="{DynamicResource BeigeTextMuted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtClassBanner" Text="하교 전 알림장과 준비물을 다시 확인해요! 🎒" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnBannerChime" Click="BtnBannerChime_Click" Content="🔔 차임벨" Padding="7,4" Margin="0,0,5,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" ToolTip="학생 주목 집중 차임벨 울리기">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="BtnEditBanner" Click="BtnEditBanner_Click" Content="✏️ 수정" Padding="7,4" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10.5" Cursor="Hand" ToolTip="안내 문구 직접 변경">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </controls:MainWidgetCard>

                                    <!-- Widget 2: 디지털 시계 (Anti-Clipping: Viewbox Auto-Scaling, MinWidth 220, MinHeight 70) -->
                                    <controls:MainWidgetCard x:Name="WidgetClock"
                                                             WidgetId="clock"
                                                             Title="디지털 시계"
                                                             Icon="⏰"
                                                             DefaultWidth="280"
                                                             DefaultHeight="74"
                                                             MinWidth="220"
                                                             MinHeight="70"
                                                             Canvas.Left="750"
                                                             Canvas.Top="0">
                                        <Border Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtBigClockTime" Text="12:00:00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" FontFamily="Segoe UI Variable Display, Malgun Gothic, Segoe UI"/>
                                                        <TextBlock x:Name="TxtBigClockDate" Text="2026년 9월 5일 (토)" FontSize="10.5" Foreground="{DynamicResource BeigeTextMuted}" Margin="1,1,0,0"/>
                                                    </StackPanel>
                                                </Viewbox>
                                                <Border Grid.Column="1" Margin="8,0,0,0" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="8" Padding="7,5" VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="🔔" FontSize="12" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtMiniClockPeriod" Text="일과 중" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </controls:MainWidgetCard>

                                    <!-- Widget 3: 오늘 시간표 (Anti-Clipping: ScrollViewer, MinWidth 280, MinHeight 260, DockPanel headers) -->
                                    <controls:MainWidgetCard x:Name="WidgetTimetable"
                                                             WidgetId="timetable"
                                                             Title="오늘 시간표"
                                                             Icon="🕒"
                                                             DefaultWidth="360"
                                                             DefaultHeight="620"
                                                             MinWidth="280"
                                                             MinHeight="260"
                                                             Canvas.Left="0"
                                                             Canvas.Top="84">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" LastChildFill="True">
                                                    <Button x:Name="BtnTogglePeriodAlarm" DockPanel.Dock="Right" Content="🔔 알람 ON" Click="BtnTogglePeriodAlarm_Click" Padding="8,3" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                    </Button>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="🕒 오늘 시간표" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}"/>
                                                        <TextBlock x:Name="TxtCurrentPeriodStatus" Text="확인 중..." FontSize="11" Foreground="{DynamicResource BeigeAccent}" Margin="0,2,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                                    <Button Content="⚙️ 예비령" Click="BtnOpenPeriodAlarmSettings_Click" Padding="2,3" Margin="0,0,3,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="수업 시작 전 카운트다운 설정">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Content="⏱️ 40분" Click="BtnLaunchClassTimer_Click" Padding="2,3" Margin="0,0,3,0" Background="{DynamicResource BeigeAccent}" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="수업 40분 집중 타이머 시작">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Content="🔄 시간조정" Click="BtnShiftTimetable_Click" Padding="2,3" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="시간표 일괄 당기기/미루기">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    </Button>
                                                </UniformGrid>
                                            </Grid>

                                            <ListBox x:Name="ListTimetable" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,0,0,4" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,5" Cursor="Hand" ToolTip="우클릭하여 과목명/태그/타이머를 빠르게 수정할 수 있습니다 (더블클릭 시 바로 수정)">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="✏️ 과목명 직접 수정..." Click="MenuEditSubject_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="📚 빠른 과목 변경">
                                                                        <MenuItem Header="국어" Click="MenuQuickSubject_Click" Tag="국어"/>
                                                                        <MenuItem Header="수학" Click="MenuQuickSubject_Click" Tag="수학"/>
                                                                        <MenuItem Header="사회" Click="MenuQuickSubject_Click" Tag="사회"/>
                                                                        <MenuItem Header="과학" Click="MenuQuickSubject_Click" Tag="과학"/>
                                                                        <MenuItem Header="영어" Click="MenuQuickSubject_Click" Tag="영어"/>
                                                                        <MenuItem Header="체육" Click="MenuQuickSubject_Click" Tag="체육"/>
                                                                        <MenuItem Header="음악" Click="MenuQuickSubject_Click" Tag="음악"/>
                                                                        <MenuItem Header="미술" Click="MenuQuickSubject_Click" Tag="미술"/>
                                                                        <MenuItem Header="도덕" Click="MenuQuickSubject_Click" Tag="도덕"/>
                                                                        <MenuItem Header="실과" Click="MenuQuickSubject_Click" Tag="실과"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="창체 (창의적 체험활동)" Click="MenuQuickSubject_Click" Tag="창체"/>
                                                                        <MenuItem Header="동아리" Click="MenuQuickSubject_Click" Tag="동아리"/>
                                                                        <MenuItem Header="자율 / 안전" Click="MenuQuickSubject_Click" Tag="자율"/>
                                                                        <MenuItem Header="진로활동" Click="MenuQuickSubject_Click" Tag="진로"/>
                                                                    </MenuItem>
                                                                    <MenuItem Header="🏷️ 수업 구분(태그) 설정">
                                                                        <MenuItem Header="담임 수업" Click="MenuQuickTag_Click" Tag="담임"/>
                                                                        <MenuItem Header="전담 수업" Click="MenuQuickTag_Click" Tag="전담"/>
                                                                        <MenuItem Header="교과 교실 (특별실)" Click="MenuQuickTag_Click" Tag="특별실"/>
                                                                        <MenuItem Header="온라인 / 원격" Click="MenuQuickTag_Click" Tag="원격"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="태그 없음" Click="MenuQuickTag_Click" Tag=""/>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="⏱️ 이 교시 40분 타이머 바로 실행" Click="MenuItemTimer_Click"/>
                                                                    <MenuItem Header="🔔 이 교시 예비 알람 토글" Click="MenuItemToggleAlarm_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="🧹 빈 시간으로 비우기" Click="MenuClearSubject_Click"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="5" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding DisplayBadge}" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}" FontSize="10.5"/>
                                                                </Border>
                                                                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" LastChildFill="True">
                                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="3" Padding="3,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Tag}" FontSize="9" Foreground="{DynamicResource BeigeTextMuted}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource BeigeTextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <Button Content="⏱️" Click="BtnItemTimer_Click" Tag="{Binding}" Width="19" Height="19" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="이 교시 타이머 실행" Margin="0,0,2,0"/>
                                                                    <Button Content="✏️" Click="BtnEditSubject_Click" Tag="{Binding}" Width="19" Height="19" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="과목 수정"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </controls:MainWidgetCard>

                                    <!-- Widget 4: 학사일정 달력 (Anti-Clipping: MinWidth 280, MinHeight 280, TextTrimming with ToolTip) -->
                                    <controls:MainWidgetCard x:Name="WidgetCalendar"
                                                             WidgetId="calendar"
                                                             Title="학사일정"
                                                             Icon="📅"
                                                             DefaultWidth="350"
                                                             DefaultHeight="400"
                                                             MinWidth="280"
                                                             MinHeight="280"
                                                             Canvas.Left="370"
                                                             Canvas.Top="84">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📅" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="학사일정" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button x:Name="BtnCalToday" Click="BtnCalToday_Click" Content="오늘" Padding="6,2" Margin="0,0,3,0" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontSize="10" Cursor="Hand">
