                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="수업 실시간 도구" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                                <TextBlock Text="수업 진행 및 학생 집중" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <UniformGrid Columns="3">
                                            <!-- Tool 1: Screen Drawing [Alt+2] -->
