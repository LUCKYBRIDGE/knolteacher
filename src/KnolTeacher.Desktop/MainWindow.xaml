                                                    <TextBlock Text="딩동댕·오답 버저·환호·박수 8종 사운드" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 12: Floating Dock [Alt+9] -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchDock_Click">
                                                <Grid>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Alt+9" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <TextBlock Text="🏝️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                        <TextBlock Text="화면 상단 도구바" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="화면 상단 미니 플로팅 툴바" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: 💼 교무 행정 & 업무 편의 (Administrative & Settings) -->
                                <Border Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="4,0,4,8">
                                            <Border DockPanel.Dock="Right" Background="#E0E7FF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="교무 행정 • 개인 편의 설정" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💼" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="교무 행정 &amp; 업무 편의" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                                <TextBlock Text="복무 계산, 직인 날인 및 학교 통계" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <UniformGrid Columns="3">
                                            <!-- Tool 13: Workday Calculator -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchWorkdayCalculator_Click">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🧮" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="월 15일 복무 계산기" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="교직수당·급식비 15일 충족 및 연가 한도" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 14: Digital Signature [Alt+S] -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchSignature_Click">
                                                <Grid>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Alt+S" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BeigeAccent}"/>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                        <TextBlock Text="🔏" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                        <TextBlock Text="전자서명 &amp; 직인 도장" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="한글(HWP) 투명 날인 &amp; 자필 서명" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Tool 15: School Scale Map -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchSchoolScale_Click">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🗺️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="전국 학교 지도 &amp; 통계" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="학생수·교원수·학급수·과밀 및 지도 조회" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 16: Hotkey Settings -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnOpenHotkeySettings_Click">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⌨️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="단축키 맞춤 설정" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Alt+1~9 즉각 실행 &amp; 단축키 커스텀" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 17: Background Tray & Hotkey Guide -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnShowHotkeyGuide_Click">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="단축키 빠른 안내" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="전역 단축키 &amp; 트레이 숨김 모드 안내" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 18: Template Download & Sharing Center -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="BtnLaunchTemplateShare_Click" ToolTip="학생 명렬, 학사일정, 주간 시간표 양식 다운로드 및 동료 교사 공유">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📋" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="양식 다운로드 &amp; 공유" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeAccent}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="학생명부·학사일정·시간표 엑셀 양식" FontSize="11" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool 19: Windows Startup Auto-run Settings -->
                                            <Border Margin="4" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🚀" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="시작 프로그램 등록" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                                    <CheckBox x:Name="ChkAutoStartup" Content="PC 시작 시 자동 실행" IsChecked="False" Click="ChkAutoStartup_Click" FontSize="11" Foreground="{DynamicResource BeigeTextSub}" HorizontalAlignment="Center" Margin="0,4,0,0" Cursor="Hand"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: 스마트 예약 센터 (Schedule) -->
                    <TabItem>
                        <Border Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header & Add Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄 정기 반복 예약 실행 &amp; 알림" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BeigeTextMain}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" (선생님 일정 및 PC 전원 자동화)" FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="+ 새로운 예약 등록" Click="BtnAddSchedule_Click" HorizontalAlignment="Right" Padding="14,8" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Scrollable Schedules List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListSchedules">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Action Icon -->
                                                        <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource BeigeAccentSoft}" CornerRadius="20" VerticalAlignment="Center" Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding ActionIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Schedule Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeTextMain}"/>
                                                                <Border Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding RepeatDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BeigeAccent}"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BeigeTextMuted}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Memo}" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FeatureSummary}" Foreground="{DynamicResource BeigeAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <!-- Time & Action Buttons -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource BeigeAccentSoft}" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding TimeString}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BeigeAccent}"/>
                                                            </Border>
                                                            <CheckBox IsChecked="{Binding Enabled}" Click="ScheduleToggle_Click" Content="활성" Foreground="{DynamicResource BeigeTextMain}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <Button Content="⚡ 테스트" Click="BtnTestSchedule_Click" Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="✏️ 수정" Click="BtnEditSchedule_Click" Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BeigeCardBg}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="🗑️" Click="BtnDeleteSchedule_Click" Padding="8,4" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="예약 삭제">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: 스마트 데스크 & 정리 (Zen Cleaner) -->
                    <TabItem>
                        <StackPanel>
                            <!-- Action 1: Auto Organize -->
                            <Border Margin="0,0,0,12" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📁" FontSize="30" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="바탕화면 1초 스마트 자동 분류 정리" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}"/>
                                        <TextBlock Text="문서, 사진, 동영상, 압축파일을 성격별 폴더로 1초 만에 깔끔하게 이동" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="↩ 실행취소 (Undo)" Click="BtnUndoOrganize_Click" Margin="0,0,8,0" Padding="12,8" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextMain}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="🧹 지금 자동 정리하기" Click="BtnOrganizeDesktop_Click" Padding="14,8" Background="{DynamicResource BeigeAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action 2: Zen Mode (Hide Icons) -->
                            <Border Margin="0,0,0,12" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🙈" FontSize="30" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="수업 집중 모드 (바탕화면 아이콘 숨기기 / 보이기)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}"/>
                                        <TextBlock Text="수업 공개나 화면 공유 시 지저분한 바탕화면 아이콘을 1초 만에 숨김" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="👁️ 아이콘 토글" Click="BtnToggleIcons_Click" Padding="14,8" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeAccent}" BorderBrush="{DynamicResource BeigeAccent}" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Action 3: Clean Temp & Downloads -->
                            <Border Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🗑️" FontSize="30" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PC 임시 파일(Temp) 안전 청소" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}"/>
                                        <TextBlock Text="30일 이상 지난 불필요한 시스템 임시 파일을 삭제하여 디스크 용량 확보" Foreground="{DynamicResource BeigeTextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🧹 임시파일 청소" Click="BtnCleanTemp_Click" Padding="14,8" Background="{DynamicResource BeigeCardInner}" Foreground="{DynamicResource BeigeTextSub}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 4: 교사용 유용한 사이트 모음 (Educational Sites) -->
                    <TabItem>
                        <Border Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 1. Pinky-NE Hero Banner -->
                                <Border Grid.Row="0" Margin="0,0,0,12" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="BannerPinky_Click" ToolTip="핑키네 공식 웹사이트 바로가기">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌟" FontSize="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="핑키네 (Pinky-NE) 교실자료실 &amp; 놀퀴즈 공식 웹사이트" FontWeight="Bold" FontSize="14" Foreground="#BE123C"/>
                                            </StackPanel>
                                            <TextBlock Text="선생님을 위한 초등 교육자료, 실시간 학급 퀴즈 게임, 수업 템플릿을 무료로 만나보세요!" FontSize="11" Foreground="#E11D48" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="📱 QR" Click="BtnBannerQr_Click" Padding="10,6" Margin="0,0,6,0" Background="White" Foreground="#E11D48" BorderBrush="#FECDD3" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="학생 태블릿 스캔용 핑키네 대형 QR코드">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="🌐 pinky-ne.com 열기 ↗" Click="BannerPinky_Click" Padding="12,6" Background="#E11D48" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2. K-에듀파인 / 교육청 업무포털 Bar (지역선택) -->
                                <Border Grid.Row="1" Margin="0,0,0,14" Background="{DynamicResource BeigeCardInner}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Top Row: Title, Dropdown, Add/Reset -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                                            <TextBlock Text="🏫" FontSize="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="시도교육청 업무포털 &amp; 나이스/에듀파인" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BeigeTextMain}"/>
