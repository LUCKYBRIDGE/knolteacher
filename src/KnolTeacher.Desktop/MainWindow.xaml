                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🏫" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="전국 학교 규모 · 통계" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BeigeTextMain}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="학생수·교원수·학급수·과밀 조회" FontSize="12" Foreground="{DynamicResource BeigeTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tool 11: Noise Traffic Light -->
                            <Border Margin="6" Background="{DynamicResource BeigeCardBg}" BorderBrush="{DynamicResource BeigeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Cursor="Hand" MouseLeftButtonUp="BtnLaunchNoiseTrafficLight_Click">
